// ============================================
// TRANSPORT
// ============================================

model TransportRoute {
  id            String    @id @default(cuid())
  schoolId      String
  routeName     String
  routeNumber   String?
  academicYear  String    @default("2025-2026")
  feeMonths     String    @default("[]")
  startPoint    String?
  endPoint      String?
  stops         String? // JSON array of stops
  distance      Float?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  fee           Float     @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school      School                @relation(fields: [schoolId], references: [id])
  allocations TransportAllocation[]
  stopFares   TransportStopFare[]

  @@index([schoolId])
}

model TransportStopFare {
  id           String   @id @default(cuid())
  schoolId     String
  routeId      String
  academicYear String
  stopName     String
  fare         Float    @default(0)
  feeMonths    String   @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  route TransportRoute @relation(fields: [routeId], references: [id])

  @@unique([routeId, academicYear, stopName])
  @@index([schoolId])
  @@index([routeId])
  @@index([academicYear])
}

model TransportAllocation {
  id                    String    @id @default(cuid())
  schoolId              String
  studentId             String
  routeId               String
  academicYear          String    @default("2025-2026")
  pickupPoint           String?
  dropPoint             String?
  stopName              String?
  fareAmount            Float     @default(0)
  feeMonths             String    @default("[]")
  isActive              Boolean   @default(true)
  // Window fields. Application sets effectiveFrom on creation and
  // effectiveTo+isActive=false together on closure. isActive is kept for
  // fast filtering; the canonical truth is effectiveTo (null OR future).
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  changeReason          String? // INITIAL | CHANGED | WITHDRAWN | REJOIN |
  // FARE_REVISION | YEAR_ROLLOVER | STUDENT_WITHDRAWN
  previousAllocationId  String? // chains successive allocations within an AY
  withdrawnBy           String? // userId who closed it
  withdrawalNotes       String?
  cascadeFromWithdrawal Boolean   @default(false) // true if closed because student TC'd
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  route TransportRoute @relation(fields: [routeId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([effectiveTo])
  @@index([previousAllocationId])
  // Speeds up "is there an active allocation for this (student, AY)?" check.
  // Race-safety for concurrent adds is enforced application-side: the POST
  // /students/[id]/transport endpoint takes a SELECT … FOR UPDATE on the
  // Student row inside its $transaction before re-checking + inserting.
  // In production, also create a partial unique index:
  //   CREATE UNIQUE INDEX CONCURRENTLY transport_alloc_active_uniq
  //     ON "TransportAllocation" ("studentId", "academicYear")
  //     WHERE "isActive" = true;
  // Prisma's schema language can't express partial unique indexes, so this
  // line lives here as a TODO for the production migration and the app
  // already handles the P2002 case if it's added.
  @@index([studentId, academicYear, isActive])
}

// Records a student leaving the school mid-year (TC, dropout, transfer).
// One row per (student, academicYear) — the unique constraint blocks
// double-issuance. `cancelledItemsJson` and `totalRefundDue` capture the
// fee snapshot at withdrawal time so an auditor can always reproduce what
// the helper cancelled vs. what required manual refund. The `reversedAt`
// pair handles erroneous-TC reversal within a configurable window.
model StudentWithdrawal {
  id                 String    @id @default(cuid())
  schoolId           String
  studentId          String
  academicYear       String
  effectiveDate      DateTime
  reason             String // TC | DROPOUT | TRANSFER | COMPLETED | OTHER
  reasonNotes        String?
  refundEligible     Boolean   @default(false)
  cancelledItemsJson String?
  cancelledAmount    Float     @default(0)
  totalRefundDue     Float     @default(0)
  performedBy        String?
  reversedAt         DateTime?
  reversedBy         String?
  reversalNotes      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  refunds StudentFeeRefund[]

  @@unique([studentId, academicYear])
  @@index([schoolId])
  @@index([studentId])
  @@index([effectiveDate])
}

// Records a single cash payout to a parent against a withdrawal's
// totalRefundDue. A withdrawal may have many partial refunds; the
// outstanding obligation is `withdrawal.totalRefundDue - sum(active refunds.amount)`.
//
// Issuing a refund writes a paired StudentFeeLedgerEntry (entryType='REFUND',
// debit=amount, credit=0, sourceType='refund') so the student ledger reflects
// the payout. Voiding a refund writes the inverse counter-entry and links it
// via voidLedgerEntryId — the original ledgerEntryId stays in place for audit.
//
// Receipt numbers are sequential per-school with an 'RFD-' prefix to keep
// them visually distinct from collection receipts (which are bare integers).
model StudentFeeRefund {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  withdrawalId    String
  scope           String // 'academic' | 'transport' | 'combined' — copied from the withdrawal context for filtering
  academicYear    String
  amount          Float
  paymentMethod   String    @default("cash") // cash | bank | adjustment — schema is forward-compatible; only 'cash' is wired today
  receiptNumber   String
  issuedDate      DateTime  @default(now())
  issuedBy        String?
  notes           String?
  ledgerEntryId   String?   // REFUND row written when the refund was issued
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  voidLedgerEntryId String? // counter-entry ledger row written on void
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  school     School            @relation(fields: [schoolId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])
  withdrawal StudentWithdrawal @relation(fields: [withdrawalId], references: [id])

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([withdrawalId])
  @@index([issuedDate])
}

// Append-only history of every transport state change for a student in an
// academic year. Each row links the (optional) from/to allocations so the
// timeline is reconstructible by `student + AY` ordered by createdAt.
// `cascadeFromWithdrawal=true` distinguishes auto-closures (student TC'd)
// from explicit transport-only withdrawals.
model TransportEvent {
  id                    String   @id @default(cuid())
  schoolId              String
  studentId             String
  academicYear          String
  eventType             String // CREATED | CHANGED | WITHDRAWN | REJOINED | FARE_REVISED
  fromAllocationId      String?
  toAllocationId        String?
  fromRouteId           String?
  toRouteId             String?
  fromStop              String?
  toStop                String?
  effectiveDate         DateTime
  cancelledMonths       String? // JSON: ["Oct","Nov","Dec"]
  cancelledAmount       Float    @default(0)
  reason                String?
  performedBy           String?
  cascadeFromWithdrawal Boolean  @default(false)
  createdAt             DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([studentId, academicYear])
  @@index([eventType])
  @@index([createdAt])
}

