// ============================================
// FEES MANAGEMENT SYSTEM
// ============================================

model FeesHead {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  frequency     String // ONE_TIME, MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY, CUSTOM
  headType      String    @default("STANDARD") // STANDARD, REFUNDABLE_DEPOSIT, NON_REFUNDABLE
  isOptional    Boolean   @default(false)
  applicability String? // JSON rules for gender/category/student type/etc.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school          School                     @relation(fields: [schoolId], references: [id])
  groupItems      FeesGroupItem[]
  structureItems  FeesStructureItem[]
  assignmentItems StudentFeeAssignmentItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model FeesGroup {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school      School                 @relation(fields: [schoolId], references: [id])
  items       FeesGroupItem[]
  structures  FeesStructure[]
  assignments StudentFeeAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model FeesGroupItem {
  id        String   @id @default(cuid())
  groupId   String
  feeHeadId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   FeesGroup @relation(fields: [groupId], references: [id])
  feeHead FeesHead  @relation(fields: [feeHeadId], references: [id])

  @@unique([groupId, feeHeadId])
}

model FeesStructure {
  id            String    @id @default(cuid())
  schoolId      String
  feesGroupId   String
  classId       String
  sectionId     String?
  academicYear  String
  name          String
  version       Int       @default(1)
  status        String    @default("active") // draft, active, archived
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  lockedAt      DateTime?
  lockedBy      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school      School                 @relation(fields: [schoolId], references: [id])
  feesGroup   FeesGroup              @relation(fields: [feesGroupId], references: [id])
  class       Class                  @relation(fields: [classId], references: [id])
  section     Section?               @relation(fields: [sectionId], references: [id])
  items       FeesStructureItem[]
  assignments StudentFeeAssignment[]

  @@index([schoolId])
  @@index([classId])
  @@index([academicYear])
  @@index([feesGroupId])
}

model FeesStructureItem {
  id              String    @id @default(cuid())
  feeStructureId  String
  feeHeadId       String
  installmentName String // Jan, Feb, Mar, Q1, H1, Annual, etc.
  amount          Float     @default(0)
  dueDate         DateTime?
  lateFee         Float     @default(0)
  frequency       String // Derived from fee head
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  feeStructure    FeesStructure              @relation(fields: [feeStructureId], references: [id])
  feeHead         FeesHead                   @relation(fields: [feeHeadId], references: [id])
  assignmentItems StudentFeeAssignmentItem[]

  @@index([feeStructureId])
  @@index([feeHeadId])
}

model FeeCollection {
  id                         String    @id @default(cuid())
  schoolId                   String
  studentId                  String
  feeStructureItemId         String?
  studentFeeAssignmentItemId String?
  studentFeeInvoiceId        String?
  amount                     Float
  paidAmount                 Float     @default(0)
  discount                   Float     @default(0)
  concession                 Float     @default(0)
  scholarship                Float     @default(0)
  fine                       Float     @default(0)
  paymentStatus              String    @default("unpaid") // unpaid, partial, paid
  paymentMethod              String? // cash, online, cheque, upi
  transactionRef             String?
  paymentDate                DateTime?
  receiptNumber              String?
  dueDate                    DateTime?
  installmentName            String?
  feeHeadName                String?
  notes                      String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  school         School                    @relation(fields: [schoolId], references: [id])
  student        Student                   @relation(fields: [studentId], references: [id])
