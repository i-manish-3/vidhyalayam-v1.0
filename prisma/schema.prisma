  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([userId])
}

model Parent {
  id             String    @id @default(cuid())
  schoolId       String
  userId         String?
  fatherName     String?
  motherName     String?
  phone          String?
  alternatePhone String?
  email          String?
  occupation     String?
  address        String?
