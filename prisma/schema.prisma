// ============================================
// RBAC - ROLE BASED ACCESS CONTROL
// ============================================

// Master permission catalog - defines all available permissions in the system
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "student:read", "student:create", "fees:collect"
  name        String // e.g., "View Students", "Create Student", "Collect Fees"
  module      String // e.g., "students", "fees", "attendance", "salary"
  description String?
  action      String // read, create, update, delete, *
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions   RolePermission[]
  schoolPermissions SchoolPermission[]
  userPermissions   UserPermission[]

  @@index([module])
  @@index([code])
}

// Custom role defined per school (school admin creates these)
model Role {
  id          String    @id @default(cuid())
  schoolId    String
  name        String // e.g., "Head Teacher", "Library Staff", "Office Staff", "Receptionist"
  description String?
  color       String? // UI color for badge
  isSystem    Boolean   @default(false) // System roles can't be deleted
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school      School           @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Links a role to specific permissions
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Permissions granted to a school by super admin (controls what school admin can do)
model SchoolPermission {
  id           String   @id @default(cuid())
  schoolId     String
  permissionId String
  grantedBy    String // Super admin user id
  grantedAt    DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([schoolId, permissionId])
  @@index([schoolId])
  @@index([permissionId])
}

// Direct permissions assigned to a user (overrides role permissions)
model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true) // true = grant, false = deny (deny overrides grant)
  grantedBy    String // Who assigned this permission
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// Links a user to a role within their school
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String // Who assigned this role
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

