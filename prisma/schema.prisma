  id        String    @id @default(cuid())
  name      String
  role      String // e.g., "Principal, DPS Delhi"
  quote     String
  stars     Int       @default(5)
  avatarUrl String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================
// LANDING PAGE PRICING
// ============================================

model PricingPlan {
  id              String    @id @default(cuid())
  name            String // e.g., "Base Plan"
  pricePerStudent Float     @default(10) // Price per student per month
  billingCycle    String    @default("monthly") // monthly, yearly
  description     String? // Short description
  features        String // JSON array of feature strings, e.g. ["Feature 1", "Feature 2"]
  highlights      String? // JSON array of highlight strings shown on the left side, e.g. ["Data migration included"]
  isActive        Boolean   @default(true)
  isPopular       Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

model PricingAddon {
  id          String    @id @default(cuid())
  name        String // e.g., "Salary & Payroll"
  description String // What this addon includes
  icon        String // Lucide icon name, e.g. "Wallet", "Crown", "Palette", "Globe"
  price       Float // Price amount
  priceLabel  String // e.g., "per staff / month", "one-time"
  type        String    @default("one_time") // recurring, one_time
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================
// LANDING PAGE TEAM MEMBERS
// ============================================

model TeamMember {
  id        String    @id @default(cuid())
  name      String // e.g., "Manish Kumar"
  role      String // e.g., "Developer", "Marketing Head"
  bio       String // Short bio/description
  image     String? // Image URL or path
  phone     String? // Contact phone
  email     String? // Contact email
  linkedin  String? // LinkedIn profile URL
  twitter   String? // X/Twitter profile URL
  github    String? // GitHub profile URL
  instagram String? // Instagram profile URL
  facebook  String? // Facebook profile URL
  website   String? // Personal website URL
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([sortOrder])
}
