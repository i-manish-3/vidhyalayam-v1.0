  @@index([schoolId])
  @@index([studentId])
  @@index([paymentStatus])
  @@index([feeStructureItemId])
  @@index([studentFeeAssignmentItemId])
  @@index([studentFeeInvoiceId])
}

model StudentFeeAssignment {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  feeStructureId String
  feesGroupId    String
  classId        String
  sectionId      String?
  academicYear   String
  name           String
  source         String    @default("manual") // admission, promotion, manual, migration
  status         String    @default("active") // active, paused, closed
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  assignedBy     String?
  assignedAt     DateTime  @default(now())
  snapshotJson   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school        School                     @relation(fields: [schoolId], references: [id])
  student       Student                    @relation(fields: [studentId], references: [id])
  feeStructure  FeesStructure              @relation(fields: [feeStructureId], references: [id])
  feesGroup     FeesGroup                  @relation(fields: [feesGroupId], references: [id])
  class         Class                      @relation(fields: [classId], references: [id])
  section       Section?                   @relation(fields: [sectionId], references: [id])
  items         StudentFeeAssignmentItem[]
  invoices      StudentFeeInvoice[]
  ledgerEntries StudentFeeLedgerEntry[]

  @@unique([studentId, feeStructureId, academicYear])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([status])
}

model StudentFeeAssignmentItem {
  id                 String    @id @default(cuid())
  assignmentId       String
  feeStructureItemId String?
  feeHeadId          String?
  feeHeadName        String
  billingBehavior    String
  installmentName    String
  amount             Float     @default(0)
  dueDate            DateTime?
  lateFee            Float     @default(0)
  headType           String    @default("STANDARD")
  isOptional         Boolean   @default(false)
  status             String    @default("active") // active, waived, cancelled, billed
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignment       StudentFeeAssignment    @relation(fields: [assignmentId], references: [id])
  feeStructureItem FeesStructureItem?      @relation(fields: [feeStructureItemId], references: [id])
  feeHead          FeesHead?               @relation(fields: [feeHeadId], references: [id])
  invoiceLines     StudentFeeInvoiceLine[]
  feeCollections   FeeCollection[]
  ledgerEntries    StudentFeeLedgerEntry[]

  @@index([assignmentId])
  @@index([feeStructureItemId])
  @@index([feeHeadId])
}

model StudentFeeInvoice {
  id                   String    @id @default(cuid())
  schoolId             String
  studentId            String
  assignmentId         String?
  invoiceNumber        String
  invoiceDate          DateTime  @default(now())
  dueDate              DateTime?
  subtotal             Float     @default(0)
  discount             Float     @default(0)
  concession           Float     @default(0)
  scholarship          Float     @default(0)
  fine                 Float     @default(0)
  totalAmount          Float     @default(0)
  paidAmount           Float     @default(0)
  status               String    @default("unpaid") // unpaid, partial, paid, cancelled
  lockedAt             DateTime?
  lockedBy             String?
  notes                String?
  // Monthly demand slip fields (Phase 1 — populated by Phase 2 generator).
  // For legacy / opening invoices these stay null and isMonthlyDemand=false.
  billingMonth         Int? // 1-12
  billingYear          Int? // e.g. 2026
  isMonthlyDemand      Boolean   @default(false)
  previousBalance      Float     @default(0) // carried-over dues at slip generation time
  generatedBy          String? // userId who triggered (null = system/seed)
  demandRunId          String?
  // Phase 5 — public share link for parent WhatsApp delivery
  publicAccessToken    String?   @unique
  publicTokenExpiresAt DateTime?
  sharedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  school        School                  @relation(fields: [schoolId], references: [id])
  student       Student                 @relation(fields: [studentId], references: [id])
  assignment    StudentFeeAssignment?   @relation(fields: [assignmentId], references: [id])
  demandRun     FeeDemandRun?           @relation(fields: [demandRunId], references: [id])
  lines         StudentFeeInvoiceLine[]
  payments      StudentFeePayment[]
  collections   FeeCollection[]
  ledgerEntries StudentFeeLedgerEntry[]
  notifications FeeNotification[]

  @@unique([schoolId, invoiceNumber])
  @@unique([schoolId, studentId, billingMonth, billingYear, isMonthlyDemand], name: "monthly_demand_unique")
  @@index([schoolId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
  @@index([demandRunId])
  @@index([schoolId, billingYear, billingMonth])
}

model StudentFeeInvoiceLine {
  id               String    @id @default(cuid())
  invoiceId        String
  assignmentItemId String?
  feeHeadName      String
  installmentName  String
  amount           Float     @default(0)
  discount         Float     @default(0)
  concession       Float     @default(0)
  scholarship      Float     @default(0)
  fine             Float     @default(0)
  totalAmount      Float     @default(0)
  dueDate          DateTime?
  status           String    @default("unpaid")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoice        StudentFeeInvoice         @relation(fields: [invoiceId], references: [id])
  assignmentItem StudentFeeAssignmentItem? @relation(fields: [assignmentItemId], references: [id])
  ledgerEntries  StudentFeeLedgerEntry[]

  @@index([invoiceId])
  @@index([assignmentItemId])
}

model StudentFeePayment {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  invoiceId      String?
  amount         Float
  paymentMethod  String
  transactionRef String?
  receiptNumber  String
  paymentDate    DateTime @default(now())
  notes          String?
  receivedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school        School                  @relation(fields: [schoolId], references: [id])
  student       Student                 @relation(fields: [studentId], references: [id])
  invoice       StudentFeeInvoice?      @relation(fields: [invoiceId], references: [id])
  ledgerEntries StudentFeeLedgerEntry[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([invoiceId])
  @@index([schoolId, paymentDate])
}

model StudentFeeLedgerEntry {
  id               String    @id @default(cuid())
  schoolId         String
  studentId        String
  academicYear     String?
  assignmentId     String?
  assignmentItemId String?
  invoiceId        String?
  invoiceLineId    String?
  paymentId        String?
  feeCollectionId  String?
  entryType        String // DEBIT, CREDIT, ADJUSTMENT, FINE, WAIVER, REFUND
  sourceType       String // assignment, transport, payment, adjustment, migration
  sourceId         String?
  feeHeadName      String?
  installmentName  String?
  description      String?
  debit            Float     @default(0)
  credit           Float     @default(0)
  balanceAmount    Float     @default(0)
  dueDate          DateTime?
  transactionDate  DateTime  @default(now())
  paymentMethod    String?
  transactionRef   String?
  receiptNumber    String?
  status           String    @default("open") // open, partial, settled, cancelled
  notes            String?
  createdBy        String?
  version          Int       @default(1) // Optimistic locking: incremented on each balance update
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  school            School                       @relation(fields: [schoolId], references: [id])
  student           Student                      @relation(fields: [studentId], references: [id])
  assignment        StudentFeeAssignment?        @relation(fields: [assignmentId], references: [id])
  assignmentItem    StudentFeeAssignmentItem?    @relation(fields: [assignmentItemId], references: [id])
  invoice           StudentFeeInvoice?           @relation(fields: [invoiceId], references: [id])
  invoiceLine       StudentFeeInvoiceLine?       @relation(fields: [invoiceLineId], references: [id])
  payment           StudentFeePayment?           @relation(fields: [paymentId], references: [id])
  feeCollection     FeeCollection?               @relation(fields: [feeCollectionId], references: [id])
  debitAllocations  StudentFeeLedgerAllocation[] @relation("DebitLedgerEntry")
  creditAllocations StudentFeeLedgerAllocation[] @relation("CreditLedgerEntry")

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([assignmentId])
  @@index([assignmentItemId])
  @@index([invoiceId])
  @@index([invoiceLineId])
  @@index([paymentId])
  @@index([feeCollectionId])
  @@index([entryType])
  @@index([status])
  @@index([dueDate])
  @@index([transactionDate])
}

model StudentFeeLedgerAllocation {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  debitEntryId  String
  creditEntryId String
  amount        Float
  allocatedAt   DateTime  @default(now())
  receiptNumber String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school      School                @relation(fields: [schoolId], references: [id])
  student     Student               @relation(fields: [studentId], references: [id])
  debitEntry  StudentFeeLedgerEntry @relation("DebitLedgerEntry", fields: [debitEntryId], references: [id])
  creditEntry StudentFeeLedgerEntry @relation("CreditLedgerEntry", fields: [creditEntryId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([debitEntryId])
  @@index([creditEntryId])
  @@index([allocatedAt])
}

model FeeAuditLog {
  id         String @id @default(cuid())
  schoolId   String
  entityType String // StudentFeePayment, StudentFeeInvoice, StudentFeeLedgerEntry, StudentFeeRefund, etc.
  entityId   String
  action     String // created, updated, deleted, payment_recorded, refund_issued, etc.

  // Enhanced fields
  studentId String? // Denormalized for fast student-scoped queries
  userId    String? // Who performed the action
  ipAddress String? // Request IP for security audits
  userAgent String? // Browser/client info

  // Snapshots
  oldValue    String? // JSON snapshot before change
  newValue    String? // JSON snapshot after change
  diffSummary String? // Human-readable summary: "Changed amount from 1000 to 1200"

  // Metadata
  metadata String? // JSON: additional context (invoice number, receipt number, etc.)

  createdAt DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([entityType, entityId])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, userId, createdAt])
  @@index([schoolId, entityType, createdAt])
  @@index([schoolId, action, createdAt])
  @@index([createdAt]) // For retention cleanup
}

model FeeConfigAuditLog {
  id         String @id @default(cuid())
  schoolId   String
  configType String // FeeDemandConfig, FeesStructure, FeesHead, FeesGroup, BillingWindow
  configId   String
  action     String // created, updated, deleted, activated, deactivated, locked

  userId    String?
  ipAddress String?
  userAgent String?

  oldValue    String? // JSON snapshot before
  newValue    String? // JSON snapshot after
  diffSummary String? // "Changed dueDay from 5 to 10"

  metadata String? // JSON: affected students count, academic year, etc.

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([configType, configId])
  @@index([schoolId, configType, createdAt])
  @@index([schoolId, userId, createdAt])
  @@index([createdAt])
}

// Per-school singleton config for monthly fee demand slip generation
// + WhatsApp notification preferences. Mirrors AdmissionSetting pattern.
model FeeDemandConfig {
  id       String @id @default(cuid())
  schoolId String @unique

  // General — when monthly slips are due (1-28 to avoid month-end edge cases)
  dueDay Int @default(10)

  // Slip number format — template with variables: {academicYear}, {month}, {year}, {sequence}
  slipNumberFormat String @default("DS/{academicYear}/{month}/{sequence}")

  // Late fine — schema ready, code skips Phase 1
  lateFeeEnabled   Boolean @default(false)
  lateFeeType      String  @default("FLAT") // FLAT | PER_DAY
  lateFeeAmount    Float   @default(0)
  lateFeeGraceDays Int     @default(0)

  // WhatsApp delivery (activated Phase 5)
  whatsappEnabled  Boolean @default(false)
  whatsappProvider String? // BAILEYS | META_CLOUD | null

  // Meta Cloud API credentials (encrypted with TOKEN_ENCRYPTION_KEY)
  metaPhoneNumberId String?
  metaAccessToken   String? // 🔒 AES-256-GCM ciphertext
  metaBusinessId    String?
  metaTemplateName  String?

  // Baileys (whatsapp-web.js) connection status
  baileysConnected    Boolean   @default(false)
  baileysPhoneNumber  String?
  baileysLastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// Audit row for each bulk demand-slip generation run.
// One row per (school, billingMonth, billingYear, trigger) — gives the
// admin "what happened on May 1st" visibility plus retry/error logs.
model FeeDemandRun {
  id            String  @id @default(cuid())
  schoolId      String
  billingMonth  Int // 1-12
  billingYear   Int
  triggerType   String  @default("MANUAL") // MANUAL | CRON
  triggeredBy   String? // userId
  status        String  @default("running") // running | completed | failed | partial
  totalStudents Int     @default(0)
  successCount  Int     @default(0)
  skippedCount  Int     @default(0)
  failedCount   Int     @default(0)
  totalAmount   Float   @default(0)
  filters       String? // JSON: { classId, sectionId, studentIds[] }
  errorLog      String? // JSON array of {studentId, error}

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  school   School              @relation(fields: [schoolId], references: [id])
  invoices StudentFeeInvoice[]

  @@index([schoolId])
  @@index([schoolId, billingYear, billingMonth])
  @@index([status])
}

// Tracks WhatsApp / SMS / email delivery attempts for a fee invoice.
// Phase 5 will populate this; Phase 1 just creates the table.
model FeeNotification {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  invoiceId     String
  channel       String // WHATSAPP | SMS | EMAIL
  provider      String? // BAILEYS | META_CLOUD | ...
  recipient     String // phone number or email
  status        String    @default("pending") // pending | sent | delivered | read | failed
  providerMsgId String?
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school  School            @relation(fields: [schoolId], references: [id])
  invoice StudentFeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([schoolId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@index([providerMsgId])
}

// ============================================
// ATTENDANCE
// ============================================

model Attendance {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  academicYear String    @default("2025-2026")
  date         DateTime
  status       String // present, absent, leave, late, half_day
  remarks      String?
  markedBy     String?
  // Channel that produced the mark. Drives UI badges (RFID vs manual) and
  // lets reports split attendance by source. Existing rows backfill to 'manual'.
  markedSource String    @default("manual") // manual | rfid_kiosk | rfid_webhook
  finalized    Boolean   @default(false)
  finalizedAt  DateTime?
  finalizedBy  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school          School  @relation(fields: [schoolId], references: [id])
  student         Student @relation(fields: [studentId], references: [id])
  markedByUser    User?   @relation("markedByUser", fields: [markedBy], references: [id])
  finalizedByUser User?   @relation("finalizedByUser", fields: [finalizedBy], references: [id])

  @@unique([schoolId, studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([date])
  @@index([schoolId, date])
}

model AttendanceAuditLog {
  id           String   @id @default(cuid())
  schoolId     String
  academicYear String
  date         DateTime
  classId      String
  sectionId    String?
  action       String // finalize, reopen
  reason       String?
  performedBy  String
  createdAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  actor  User   @relation("attendanceAuditActor", fields: [performedBy], references: [id])

  @@index([schoolId])
  @@index([academicYear])
  @@index([schoolId, date, classId, sectionId])
  @@index([performedBy])
}

// Per-student attendance change log. Only mutations are recorded (when an
// existing Attendance row's status or remarks change). First-time marks are
// covered by Attendance.createdAt + markedBy, so they are intentionally NOT
// logged here. Use this for accountability when someone reopens a finalized
// attendance and edits a student's status.
model AttendanceChangeLog {
  id           String   @id @default(cuid())
  schoolId     String
  academicYear String
  studentId    String
  date         DateTime
  oldStatus    String
  newStatus    String
  oldRemarks   String?
  newRemarks   String?
  changedBy    String
  changedAt    DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  changer User    @relation("attendanceChanger", fields: [changedBy], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@index([schoolId, date])
  @@index([schoolId, studentId, date])
  @@index([changedBy])
  @@index([changedAt])
}

// ============================================
// RFID / NFC CARD ATTENDANCE
// ============================================

// Year-scoped card-to-student mapping. A student gets a new StudentCard row
// each academic year (matches the school's "new printed card on promotion"
// practice). Previous-year rows stay for audit; tap-time lookup filters by
// current AY so old cards naturally stop working on AY rollover with no
// manual revocation needed.
//
// UID-only model: we never write to the card. The factory-burned UID is the
// only identifier; lost-card replacement = revoke + create new row with the
// next physical card's UID.
model StudentCard {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  academicYear String // year this card is valid for
  uid          String // normalized: uppercase hex, no separators
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  assignedBy   String? // userId
  revokedAt    DateTime?
  revokedBy    String? // userId
  revokeReason String?
  printNotes   String? // free text e.g. "yellow border, batch 2026-A"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school   School  @relation(fields: [schoolId], references: [id])
  student  Student @relation(fields: [studentId], references: [id])
  assigner User?   @relation("rfidCardsAssigned", fields: [assignedBy], references: [id])
  revoker  User?   @relation("rfidCardsRevoked", fields: [revokedBy], references: [id])

  // A UID maps to at most one student within a (school, year). Across years
  // the same UID may legitimately re-appear (same physical card reissued, or
  // a previously-revoked card reused for a different student next year).
  @@unique([schoolId, academicYear, uid])
  @@index([schoolId, uid, academicYear, isActive]) // tap-time lookup
  @@index([schoolId, studentId, academicYear]) // student's card history
  @@index([schoolId, academicYear, isActive]) // admin: list active cards in current AY
}

// Networked RFID reader (ESP32, commercial gate reader, etc.) that posts
// taps to /api/rfid/webhook. Authenticates with a plaintext API key sent in
// the `x-device-key` header; only the bcrypt-hashed form is persisted.
// Cookie/JWT auth is not used because these devices have no browser session.
model RfidDevice {
  id         String    @id @default(cuid())
  schoolId   String
  name       String // "Main Gate", "Hostel Block A"
  location   String?
  apiKeyHash String    @unique // bcrypt hash of the plaintext device key
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  lastSeenIp String?
  createdBy  String? // userId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  school  School       @relation(fields: [schoolId], references: [id])
  tapLogs RfidTapLog[]

  @@index([schoolId, isActive])
  @@index([schoolId, deletedAt])
}

// Append-only log of every tap that hits the system — including unmatched
// UIDs, duplicates, and rejected taps (finalized day, non-teaching, etc.).
// Used for device debugging, "suspect taps" admin review, and rate metering.
model RfidTapLog {
  id           String   @id @default(cuid())
  schoolId     String
  uid          String // normalized
  studentId    String? // null when UID didn't match any active card
  deviceId     String? // null for kiosk taps (cookie-authenticated)
  source       String // 'kiosk' | 'webhook'
  tappedAt     DateTime @default(now())
  result       String // 'marked' | 'duplicate' | 'unknown_card' | 'finalized' | 'non_teaching' | 'enrollment_missing' | 'card_revoked'
  academicYear String? // active AY at tap time (null only if pre-lookup failure)
  errorDetail  String?

  school  School      @relation(fields: [schoolId], references: [id])
  device  RfidDevice? @relation(fields: [deviceId], references: [id])
  student Student?    @relation("rfidTapLogs", fields: [studentId], references: [id])

  @@index([schoolId, tappedAt])
  @@index([schoolId, studentId, tappedAt])
  @@index([schoolId, result, tappedAt])
  @@index([deviceId, tappedAt])
}

// ============================================
// TIMETABLE
// ============================================

model Timetable {
  id           String    @id @default(cuid())
  schoolId     String
  academicYear String    @default("2025-2026")
  classId      String
  sectionId    String
  subjectId    String
  teacherId    String
  day          String // Monday-Saturday
  period       Int // 1-8
  startTime    String?
  endTime      String?
  roomNo       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([schoolId, academicYear, sectionId, day, period])
  @@index([schoolId])
  @@index([academicYear])
  @@index([sectionId])
  @@index([teacherId, day, period])
}

model PeriodConfig {
  id        String   @id @default(cuid())
  schoolId  String
  period    Int // 1-10
  startTime String // "08:00"
  endTime   String // "08:40"
  label     String? // "Period 1", "Lunch", etc.
  isBreak   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, period])
  @@index([schoolId])
}

// ============================================
// EXAM SYSTEM
// ============================================
// Hierarchy:
//   ExamParadigm (per-school, per-AY framework)
//     └─ ExamGroup (Term 1, Term 2, Test Series 1)
//          └─ Exam (Unit Test 1, Half Yearly, Annual)
//               ├─ ExamClass (which classes this exam runs for)
//               ├─ ExamSchedule (when each subject is held)
//               └─ ExamSubjectConfig (per class × subject pattern)
//                    └─ ExamComponent (Theory 80 / Practical 20 / etc.)
//                         └─ MarksEntry (per student × component)
//
// Result rollup: MarksEntry → ResultSubjectSummary → ExamResult
//                ExamResult(s) → ExamGroupResult → FinalResult
//
// All tables carry schoolId for tenant isolation and deletedAt for soft delete
// where deletion is supported.

// A school's overall exam framework for an academic year.
// Examples: "CBSE Term Pattern 2026-27", "Coaching Test Series 2026-27",
// "State Board Annual 2026-27". Holds the rules that aggregate group-level
// results into a final/annual outcome.
model ExamParadigm {
  id              String    @id @default(cuid())
  schoolId        String
  academicYear    String
  name            String
  description     String?
  // JSON shapes:
  //   { type: "weighted", components: [{ examGroupId, weight }] }
  //   { type: "best_of_n", n: 2, examGroupIds: [...] }
  //   { type: "sum_all" }
  aggregationRule String
  // JSON: { perSubject: 33, overall: 33, allowGrace: true, graceMax: 5 }
  passingRule     String
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  school     School      @relation(fields: [schoolId], references: [id])
  examGroups ExamGroup[]

  @@unique([schoolId, academicYear, name])
  @@index([schoolId, academicYear, isActive])
}

// A grouping of one or more exams that aggregate together as a single block.
// Examples under CBSE: "Term 1" (Unit Test 1 + Half Yearly), "Term 2" (Unit
// Test 2 + Annual). Examples under coaching: "Test Series 1" (10 weekly tests,
// best-of-8 aggregation).
model ExamGroup {
  id              String    @id @default(cuid())
  schoolId        String
  paradigmId      String
  name            String
  shortCode       String?
  sequence        Int       @default(0)
  weight          Float     @default(100) // % weight in final paradigm rollup
  // JSON; null means "sum_all". Same shape as ExamParadigm.aggregationRule.
  aggregationRule String?
  isCoScholastic  Boolean   @default(false) // grade-only, no marks summed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  paradigm ExamParadigm @relation(fields: [paradigmId], references: [id])
  exams    Exam[]

  @@index([schoolId, paradigmId])
}

// A concrete exam instance. Lives under exactly one ExamGroup.
model Exam {
  id              String    @id @default(cuid())
  schoolId        String
  academicYear    String
  examGroupId     String
  name            String // "Unit Test 1", "Half Yearly", "Annual"
  shortCode       String? // "UT1"
  examType        String    @default("written") // written | practical | oral | project | internal | activity | attendance
  startDate       DateTime?
  endDate         DateTime?
  status          String    @default("draft") // draft | scheduled | ongoing | completed | result_published
  includeInResult Boolean   @default(true)
  visibleToParent Boolean   @default(false) // becomes true on publish
  // Optional pointer to the exam this re-exam/improvement attempt is for.
  // Phase 6 wires UI; column exists from day 1 for future-proofing.
  parentExamId    String?
  createdBy       String?
  publishedAt     DateTime?
  publishedBy     String?
  lockedAt        DateTime?
  lockedBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  school         School              @relation(fields: [schoolId], references: [id])
  group          ExamGroup           @relation(fields: [examGroupId], references: [id])
  examClasses    ExamClass[]
  schedules      ExamSchedule[]
  subjectConfigs ExamSubjectConfig[]
  marks          MarksEntry[]
  results        ExamResult[]

  @@unique([schoolId, academicYear, examGroupId, name])
  @@index([schoolId, academicYear, status])
  @@index([parentExamId])
}

// Which classes this exam runs for. Section-level narrowing is optional;
// when null, all sections of the class are in scope.
model ExamClass {
  id         String  @id @default(cuid())
  examId     String
  classId    String
  sectionIds String? // JSON array of sectionIds; null = all sections

  exam Exam @relation(fields: [examId], references: [id])

  @@unique([examId, classId])
  @@index([classId])
}

// The "exam pattern" row: total/passing marks for a specific (exam, class,
// section?, subject). Components break down totalMarks into channels.
model ExamSubjectConfig {
  id              String    @id @default(cuid())
  schoolId        String
  examId          String
  classId         String
  sectionId       String? // null = all sections of class
  subjectId       String
  isCompulsory    Boolean   @default(true)
  isOptional      Boolean   @default(false)
  isAdditional    Boolean   @default(false)
  gradeOnly       Boolean   @default(false) // co-scholastic: grade only, no marks
  totalMarks      Float     @default(100)
  passingMarks    Float     @default(33)
  graceMarksMax   Float     @default(0)
  examDate        DateTime?
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  exam       Exam            @relation(fields: [examId], references: [id])
  components ExamComponent[]
  marks      MarksEntry[]

  @@unique([examId, classId, subjectId, sectionId])
  @@index([schoolId, examId])
  @@index([schoolId, subjectId])
}

// A scoring channel inside an ExamSubjectConfig (Theory, Practical, Internal,
// Project, Viva, Attendance, etc.). Component maxMarks must sum to the parent
// ExamSubjectConfig.totalMarks — enforced by the API, not by the DB.
model ExamComponent {
  id              String   @id @default(cuid())
  subjectConfigId String
  name            String
  shortCode       String?
  sequence        Int      @default(0)
  maxMarks        Float
  passingMarks    Float    @default(0) // 0 = no per-component passing rule
  gradeOnly       Boolean  @default(false) // numeric component vs grade-only channel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subjectConfig ExamSubjectConfig @relation(fields: [subjectConfigId], references: [id], onDelete: Cascade)
  marks         MarksEntry[]

  @@index([subjectConfigId])
}

// Per-student opt-in for an optional/additional subject. Compulsory subjects
// implicitly apply to every student in the class — no row needed for those.
// `replacing_compulsory` covers students who drop a compulsory subject for a
// different one (e.g. Hindi → Sanskrit).
model StudentSubjectMapping {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String
  academicYear      String
  subjectId         String
  mappingType       String // optional | additional | replacing_compulsory
  replacesSubjectId String? // set when mappingType = replacing_compulsory
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@unique([studentId, academicYear, subjectId])
  @@index([schoolId, academicYear])
  @@index([studentId])
}

// Datesheet row for an exam. Schedule + invigilation. Soft delete deferred to
// Phase 6 — we hard delete during the planning phase and the audit log captures
// history.
model ExamSchedule {
  id              String   @id @default(cuid())
  schoolId        String
  examId          String
  classId         String
  sectionId       String?
  subjectId       String
  examDate        DateTime
  startTime       String // "10:00"
  endTime         String // "13:00"
  roomNumber      String?
  invigilatorId   String?
  maxMarks        Float
  durationMinutes Int
  instructions    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id])

  @@unique([examId, classId, sectionId, subjectId])
  @@index([schoolId, examDate])
  @@index([classId, sectionId, examDate])
}

// One row per (student, subjectConfig, component). For grade-only configs
// where there are no components, componentId is null and gradeValue carries
// the assessment. status overrides numericValue when student is absent / ML /
// not applicable. Optimistic locking via `version`; lockedAt enforces admin
// freeze on the entry.
model MarksEntry {
  id              String    @id @default(cuid())
  schoolId        String
  examId          String
  subjectConfigId String
  componentId     String? // null for grade-only configs
  studentId       String
  numericValue    Float?
  gradeValue      String? // 'A1', 'B2'… resolved against GradeScale
  status          String    @default("entered") // entered | absent | medical_leave | not_applicable
  graceMarks      Float     @default(0)
  remarks         String?
  enteredBy       String?
  enteredAt       DateTime?
  submittedAt     DateTime? // teacher Submit
  lockedAt        DateTime? // admin lock — immutable after this
  lockedBy        String?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  exam          Exam              @relation(fields: [examId], references: [id])
  subjectConfig ExamSubjectConfig @relation(fields: [subjectConfigId], references: [id])
  component     ExamComponent?    @relation(fields: [componentId], references: [id])
  student       Student           @relation(fields: [studentId], references: [id])

  @@unique([studentId, subjectConfigId, componentId])
  @@index([schoolId, examId])
  @@index([studentId])
  @@index([examId, subjectConfigId])
}

// A dynamic grading scale. Bands resolve marks/percentage/CGPA to a letter
// grade. Scope can narrow to a paradigm/group/class; null scopes mean "default
// for this school".
model GradeScale {
  id           String    @id @default(cuid())
  schoolId     String
  name         String // "CBSE 9-point", "Coaching A-F", "State 5-point"
  paradigmId   String?
  examGroupId  String?
  classId      String?
  scaleType    String    @default("percentage") // percentage | marks | cgpa
  isActive     Boolean   @default(true)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school School      @relation(fields: [schoolId], references: [id])
  bands  GradeBand[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model GradeBand {
  id           String  @id @default(cuid())
  gradeScaleId String
  code         String // "A1", "B+", "Distinction"
  minValue     Float
  maxValue     Float
  gradePoint   Float?
  remark       String?
  sequence     Int     @default(0)

  scale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@unique([gradeScaleId, code])
  @@index([gradeScaleId])
}

// Per-(student, exam) outcome. Rebuilt by the calc engine — never hand-edited.
// `failedSubjects` is a JSON array of {subjectId, subjectName, percentage}.
model ExamResult {
  id             String    @id @default(cuid())
  schoolId       String
  academicYear   String
  examId         String
  studentId      String
  totalMarks     Float     @default(0)
  obtainedMarks  Float     @default(0)
  percentage     Float     @default(0)
  grade          String?
  gradePoint     Float?
  rankInClass    Int?
  rankInSection  Int?
  status         String    @default("pass") // pass | fail | absent | partial
  failedSubjects String? // JSON array
  remarks        String?
  computedAt     DateTime?
  computedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school           School                 @relation(fields: [schoolId], references: [id])
  exam             Exam                   @relation(fields: [examId], references: [id])
  student          Student                @relation(fields: [studentId], references: [id])
  subjectSummaries ResultSubjectSummary[]

  @@unique([examId, studentId])
  @@index([schoolId, academicYear])
  @@index([examId, status])
}

// Per-subject breakdown of an ExamResult. subjectName is denormalized so that
// historical report cards stay correct even if the Subject row is later
// renamed/archived.
model ResultSubjectSummary {
  id             String  @id @default(cuid())
  resultId       String
  subjectId      String
  subjectName    String
  totalMarks     Float
  obtainedMarks  Float
  percentage     Float
  grade          String?
  gradePoint     Float?
  status         String // pass | fail | absent | not_applicable
  componentsJson String? // JSON snapshot: { componentName: { obtained, max } }

  result ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
}

// Group-level rollup (e.g. "Term 1 result for student X"). Stored rather than
// computed on the fly so report cards stay fast and historically stable.
model ExamGroupResult {
  id            String    @id @default(cuid())
  schoolId      String
  academicYear  String
  examGroupId   String
  studentId     String
  totalMarks    Float     @default(0)
  obtainedMarks Float     @default(0)
  percentage    Float     @default(0)
  grade         String?
  rankInClass   Int?
  status        String    @default("pass")
  computedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([examGroupId, studentId])
  @@index([schoolId, academicYear])
}

// Paradigm-level (annual) rollup. Drives the annual report card and promotion
// decisions.
model FinalResult {
  id              String    @id @default(cuid())
  schoolId        String
  academicYear    String
  paradigmId      String
  studentId       String
  totalMarks      Float     @default(0)
  obtainedMarks   Float     @default(0)
  percentage      Float     @default(0)
  grade           String?
  rankInClass     Int?
  rankInSection   Int?
  attendancePct   Float?
  promotionStatus String    @default("pending") // promoted | detained | conditional | withheld | pending
  remarks         String?
  computedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([paradigmId, studentId])
  @@index([schoolId, academicYear, promotionStatus])
}

// Per-school report card template. layoutJson follows the same dual-mode shape
// as IdCardTemplate (declarative element list OR raw HTML/CSS) — we'll start
// with the declarative form in Phase 5.
model ReportCardTemplate {
  id                   String    @id @default(cuid())
  schoolId             String
  name                 String
  description          String?
  format               String    @default("cbse") // cbse | simple | term_wise | grade_only | coaching
  appliesToParadigmId  String?
  layoutJson           String
  includeAttendance    Boolean   @default(true)
  includeRank          Boolean   @default(true)
  includeCoScholastic  Boolean   @default(true)
  showPrincipalRemarks Boolean   @default(true)
  showTeacherRemarks   Boolean   @default(true)
  isDefault            Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

// Subject-teacher scoping for marks entry. Class-teacher access is already
// covered by ClassTeacherAssignment (separate table). A teacher with a row
// here can edit marks for the exact (class, section?, subject) combo.
model TeacherSubjectAssignment {
  id           String    @id @default(cuid())
  schoolId     String
  academicYear String
  teacherId    String
  classId      String
  sectionId    String? // null = all sections of class
  subjectId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([schoolId, academicYear, teacherId, classId, sectionId, subjectId])
  @@index([schoolId, academicYear])
  @@index([teacherId, academicYear])
  @@index([schoolId, classId, sectionId, subjectId])
}

// Audit row for every meaningful exam mutation. Same shape as FeeAuditLog
// (consistency across modules). Retention worker in src/lib/audit/retention.ts
// will be extended in Phase 6 to cover this table.
model ExamAuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  entityType  String // Exam | ExamSubjectConfig | MarksEntry | ExamResult | FinalResult | ReportCardTemplate | GradeScale | ExamParadigm | ExamGroup | ExamSchedule
  entityId    String
  action      String // created | updated | deleted | marks_entered | marks_submitted | marks_locked | marks_unlocked | result_calculated | result_published | result_unpublished | report_downloaded | status_changed
  studentId   String?
  examId      String?
  userId      String?
  ipAddress   String?
  userAgent   String?
  oldValue    String? // JSON snapshot before
  newValue    String? // JSON snapshot after
  diffSummary String? // "Maths Theory: 65→72"
  metadata    String? // JSON: additional context
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, entityType, createdAt])
  @@index([schoolId, examId, createdAt])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, action, createdAt])
  @@index([createdAt])
}

// ============================================
// SALARY MANAGEMENT
// ============================================

model SalaryStructure {
  id               String   @id @default(cuid())
  schoolId         String
  teacherId        String   @unique
  basicSalary      Float    @default(0)
  hra              Float    @default(0)
  da               Float    @default(0)
  ta               Float    @default(0)
  medicalAllowance Float    @default(0)
  specialAllowance Float    @default(0)
  pf               Float    @default(0)
  esi              Float    @default(0)
  tax              Float    @default(0)
  otherDeductions  Float    @default(0)
  grossSalary      Float    @default(0)
  netSalary        Float    @default(0)
  effectiveFrom    DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id])
  teacher  Teacher         @relation(fields: [teacherId], references: [id])
  payments SalaryPayment[]

  @@index([schoolId, teacherId])
  @@index([schoolId])
}

model SalaryPayment {
  id                String    @id @default(cuid())
  schoolId          String
  teacherId         String
  salaryStructureId String?
  month             Int
  year              Int
  basicSalary       Float     @default(0)
  hra               Float     @default(0)
  da                Float     @default(0)
  ta                Float     @default(0)
  medicalAllowance  Float     @default(0)
  specialAllowance  Float     @default(0)
  grossEarnings     Float     @default(0)
  pf                Float     @default(0)
  esi               Float     @default(0)
  tax               Float     @default(0)
  advanceDeduction  Float     @default(0)
  otherDeductions   Float     @default(0)
  totalDeductions   Float     @default(0)
  netPayable        Float     @default(0)
  paymentStatus     String    @default("pending") // pending, paid
  paymentDate       DateTime?
  paymentMethod     String?
  transactionRef    String?
  generatedOn       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School           @relation(fields: [schoolId], references: [id])
  teacher         Teacher          @relation(fields: [teacherId], references: [id])
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  @@unique([schoolId, teacherId, month, year])
  @@index([schoolId])
  @@index([teacherId])
}

model AdvanceRequest {
  id             String    @id @default(cuid())
  schoolId       String
  teacherId      String
  amount         Float
  reason         String?
  requestDate    DateTime
  approvalStatus String    @default("pending") // pending, approved, rejected
  approvedBy     String?
  approvedAt     DateTime?
  deductionMonth Int?
  deductionYear  Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([teacherId])
}

// ============================================
// TRANSPORT
// ============================================

model TransportRoute {
  id            String    @id @default(cuid())
  schoolId      String
  routeName     String
  routeNumber   String?
  academicYear  String    @default("2025-2026")
  feeMonths     String    @default("[]")
  startPoint    String?
  endPoint      String?
  stops         String? // JSON array of stops
  distance      Float?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  fee           Float     @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school      School                @relation(fields: [schoolId], references: [id])
  allocations TransportAllocation[]
  stopFares   TransportStopFare[]

  @@index([schoolId])
}

model TransportStopFare {
  id           String   @id @default(cuid())
  schoolId     String
  routeId      String
  academicYear String
  stopName     String
  fare         Float    @default(0)
  feeMonths    String   @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  route TransportRoute @relation(fields: [routeId], references: [id])

  @@unique([routeId, academicYear, stopName])
  @@index([schoolId])
  @@index([routeId])
  @@index([academicYear])
}

model TransportAllocation {
  id                    String    @id @default(cuid())
  schoolId              String
  studentId             String
  routeId               String
  academicYear          String    @default("2025-2026")
  pickupPoint           String?
  dropPoint             String?
  stopName              String?
  fareAmount            Float     @default(0)
  feeMonths             String    @default("[]")
  isActive              Boolean   @default(true)
  // Window fields. Application sets effectiveFrom on creation and
  // effectiveTo+isActive=false together on closure. isActive is kept for
  // fast filtering; the canonical truth is effectiveTo (null OR future).
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  changeReason          String? // INITIAL | CHANGED | WITHDRAWN | REJOIN |
  // FARE_REVISION | YEAR_ROLLOVER | STUDENT_WITHDRAWN
  previousAllocationId  String? // chains successive allocations within an AY
  withdrawnBy           String? // userId who closed it
  withdrawalNotes       String?
  cascadeFromWithdrawal Boolean   @default(false) // true if closed because student TC'd
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  route TransportRoute @relation(fields: [routeId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([effectiveTo])
  @@index([previousAllocationId])
  // Speeds up "is there an active allocation for this (student, AY)?" check.
  // Race-safety for concurrent adds is enforced application-side: the POST
  // /students/[id]/transport endpoint takes a SELECT … FOR UPDATE on the
  // Student row inside its $transaction before re-checking + inserting.
  // In production, also create a partial unique index:
  //   CREATE UNIQUE INDEX CONCURRENTLY transport_alloc_active_uniq
  //     ON "TransportAllocation" ("studentId", "academicYear")
  //     WHERE "isActive" = true;
  // Prisma's schema language can't express partial unique indexes, so this
  // line lives here as a TODO for the production migration and the app
  // already handles the P2002 case if it's added.
  @@index([studentId, academicYear, isActive])
}

// Records a student leaving the school mid-year (TC, dropout, transfer).
// One row per (student, academicYear) — the unique constraint blocks
// double-issuance. `cancelledItemsJson` and `totalRefundDue` capture the
// fee snapshot at withdrawal time so an auditor can always reproduce what
// the helper cancelled vs. what required manual refund. The `reversedAt`
// pair handles erroneous-TC reversal within a configurable window.
model StudentWithdrawal {
  id                 String    @id @default(cuid())
  schoolId           String
  studentId          String
  academicYear       String
  effectiveDate      DateTime
  reason             String // TC | DROPOUT | TRANSFER | COMPLETED | OTHER
  reasonNotes        String?
  refundEligible     Boolean   @default(false)
  cancelledItemsJson String?
  cancelledAmount    Float     @default(0)
  totalRefundDue     Float     @default(0)
  performedBy        String?
  reversedAt         DateTime?
  reversedBy         String?
  reversalNotes      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  school  School             @relation(fields: [schoolId], references: [id])
  student Student            @relation(fields: [studentId], references: [id])
  refunds StudentFeeRefund[]

  @@unique([studentId, academicYear])
  @@index([schoolId])
  @@index([studentId])
  @@index([effectiveDate])
}

// Records a single cash payout to a parent against a withdrawal's
// totalRefundDue. A withdrawal may have many partial refunds; the
// outstanding obligation is `withdrawal.totalRefundDue - sum(active refunds.amount)`.
//
// Issuing a refund writes a paired StudentFeeLedgerEntry (entryType='REFUND',
// debit=amount, credit=0, sourceType='refund') so the student ledger reflects
// the payout. Voiding a refund writes the inverse counter-entry and links it
// via voidLedgerEntryId — the original ledgerEntryId stays in place for audit.
//
// Receipt numbers are sequential per-school with an 'RFD-' prefix to keep
// them visually distinct from collection receipts (which are bare integers).
model StudentFeeRefund {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String
  withdrawalId      String
  scope             String // 'academic' | 'transport' | 'combined' — copied from the withdrawal context for filtering
  academicYear      String
  amount            Float
  paymentMethod     String    @default("cash") // cash | bank | adjustment — schema is forward-compatible; only 'cash' is wired today
  receiptNumber     String
  issuedDate        DateTime  @default(now())
  issuedBy          String?
  notes             String?
  ledgerEntryId     String? // REFUND row written when the refund was issued
  voidedAt          DateTime?
  voidedBy          String?
  voidReason        String?
  voidLedgerEntryId String? // counter-entry ledger row written on void
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  school     School            @relation(fields: [schoolId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])
  withdrawal StudentWithdrawal @relation(fields: [withdrawalId], references: [id])

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([withdrawalId])
  @@index([issuedDate])
}

// Append-only history of every transport state change for a student in an
// academic year. Each row links the (optional) from/to allocations so the
// timeline is reconstructible by `student + AY` ordered by createdAt.
// `cascadeFromWithdrawal=true` distinguishes auto-closures (student TC'd)
// from explicit transport-only withdrawals.
model TransportEvent {
  id                    String   @id @default(cuid())
  schoolId              String
  studentId             String
  academicYear          String
  eventType             String // CREATED | CHANGED | WITHDRAWN | REJOINED | FARE_REVISED
  fromAllocationId      String?
  toAllocationId        String?
  fromRouteId           String?
  toRouteId             String?
  fromStop              String?
  toStop                String?
  effectiveDate         DateTime
  cancelledMonths       String? // JSON: ["Oct","Nov","Dec"]
  cancelledAmount       Float    @default(0)
  reason                String?
  performedBy           String?
  cascadeFromWithdrawal Boolean  @default(false)
  createdAt             DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([studentId, academicYear])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================
// HOSTEL
// ============================================
// Mirrors the transport subsystem (Route -> StopFare -> Allocation -> Event)
// with an added physical-capacity layer: Hostel -> Room -> Bed. A bed holds at
// most one student per academic year; the invariant is enforced application-side
// with a SELECT ... FOR UPDATE on the bed row inside the allocation transaction
// (same race-safety pattern transport uses on the Student row).
//
// As with transport, "Hostel Fee" is intentionally NOT a FeesHead — hostel
// billing is monthly FeeCollection rows tagged sourceType='hostel' in the ledger.

model Hostel {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  type         String? // boys | girls | mixed
  academicYear String    @default("2025-2026")
  feeMonths    String    @default("[]")
  wardenName   String?
  wardenPhone  String?
  address      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school      School             @relation(fields: [schoolId], references: [id])
  rooms       HostelRoom[]
  roomFares   HostelRoomFare[]
  allocations HostelAllocation[]

  @@index([schoolId])
}

model HostelRoom {
  id         String    @id @default(cuid())
  schoolId   String
  hostelId   String
  roomNumber String
  roomType   String? // AC | Non-AC | 2-seater | 4-seater | dormitory, etc.
  floor      String?
  capacity   Int       @default(1) // bed count; kept in sync with HostelBed rows
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  hostel      Hostel             @relation(fields: [hostelId], references: [id])
  beds        HostelBed[]
  fares       HostelRoomFare[]
  allocations HostelAllocation[]

  @@unique([hostelId, roomNumber])
  @@index([schoolId])
  @@index([hostelId])
}

model HostelBed {
  id         String    @id @default(cuid())
  schoolId   String
  hostelId   String
  roomId     String
  bedNumber  String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  room        HostelRoom         @relation(fields: [roomId], references: [id])
  allocations HostelAllocation[]

  @@unique([roomId, bedNumber])
  @@index([schoolId])
  @@index([hostelId])
  @@index([roomId])
}

// Per-year fare for a room. Mirrors TransportStopFare. fareAmount is always read
// from the TARGET year's row on allocation/carry-forward, so a fare increase
// flows through automatically and is never copied from a stale allocation.
model HostelRoomFare {
  id           String   @id @default(cuid())
  schoolId     String
  hostelId     String
  roomId       String
  academicYear String
  fare         Float    @default(0)
  feeMonths    String   @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostel Hostel     @relation(fields: [hostelId], references: [id])
  room   HostelRoom @relation(fields: [roomId], references: [id])

  @@unique([roomId, academicYear])
  @@index([schoolId])
  @@index([hostelId])
  @@index([roomId])
  @@index([academicYear])
}

model HostelAllocation {
  id                    String    @id @default(cuid())
  schoolId              String
  studentId             String
  hostelId              String
  roomId                String
  bedId                 String
  academicYear          String    @default("2025-2026")
  fareAmount            Float     @default(0)
  feeMonths             String    @default("[]")
  isActive              Boolean   @default(true)
  // Window fields. Application sets effectiveFrom on creation and
  // effectiveTo+isActive=false together on closure. isActive is kept for fast
  // filtering; the canonical truth is effectiveTo (null OR future).
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  changeReason          String? // INITIAL | CHANGED | WITHDRAWN | REJOIN |
  // FARE_REVISION | YEAR_ROLLOVER | STUDENT_WITHDRAWN
  previousAllocationId  String? // chains successive allocations within an AY
  withdrawnBy           String? // userId who closed it
  withdrawalNotes       String?
  cascadeFromWithdrawal Boolean   @default(false) // true if closed because student TC'd
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  hostel Hostel     @relation(fields: [hostelId], references: [id])
  room   HostelRoom @relation(fields: [roomId], references: [id])
  bed    HostelBed  @relation(fields: [bedId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([effectiveTo])
  @@index([previousAllocationId])
  // Speeds up "is this (student, AY) already allocated?" and "is this bed taken
  // this year?" checks. Race-safety for concurrent adds is enforced
  // application-side: the POST /students/[id]/hostel endpoint takes a
  // SELECT ... FOR UPDATE on the HostelBed row inside its $transaction before
  // re-checking + inserting.
  // In production, also create partial unique indexes:
  //   CREATE UNIQUE INDEX CONCURRENTLY hostel_alloc_student_active_uniq
  //     ON "HostelAllocation" ("studentId", "academicYear") WHERE "isActive" = true;
  //   CREATE UNIQUE INDEX CONCURRENTLY hostel_alloc_bed_active_uniq
  //     ON "HostelAllocation" ("bedId", "academicYear") WHERE "isActive" = true;
  // Prisma's schema language can't express partial unique indexes, so these
  // live here as TODOs for the production migration; the app already handles
  // the P2002 case if they're added.
  @@index([studentId, academicYear, isActive])
  @@index([bedId, academicYear, isActive])
}

// Append-only history of every hostel state change for a student in an academic
// year. Mirrors TransportEvent.
model HostelEvent {
  id                    String   @id @default(cuid())
  schoolId              String
  studentId             String
  academicYear          String
  eventType             String // CREATED | CHANGED | WITHDRAWN | REJOINED | FARE_REVISED
  fromAllocationId      String?
  toAllocationId        String?
  fromHostelId          String?
  toHostelId            String?
  fromRoom              String?
  toRoom                String?
  fromBed               String?
  toBed                 String?
  effectiveDate         DateTime
  cancelledMonths       String? // JSON: ["Oct","Nov","Dec"]
  cancelledAmount       Float    @default(0)
  reason                String?
  performedBy           String?
  cascadeFromWithdrawal Boolean  @default(false)
  createdAt             DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([studentId, academicYear])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================
// LIBRARY
// ============================================

model LibraryBook {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  author      String?
  isbn        String?
  publisher   String?
  category    String?
  edition     String?
  quantity    Int       @default(1)
  available   Int       @default(1)
  shelfNumber String?
  price       Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school School      @relation(fields: [schoolId], references: [id])
  issues BookIssue[]

  @@index([schoolId])
}

model BookIssue {
  id         String    @id @default(cuid())
  schoolId   String
  bookId     String
  studentId  String?
  teacherId  String?
  issueDate  DateTime
  dueDate    DateTime
  returnDate DateTime?
  fine       Float     @default(0)
  status     String    @default("issued") // issued, returned, overdue
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school School      @relation(fields: [schoolId], references: [id])
  book   LibraryBook @relation(fields: [bookId], references: [id])

  @@index([schoolId])
  @@index([bookId])
}

// ============================================
// INVENTORY
// ============================================

// A product (e.g. "School Shirt", "Class V Book Set", "Trophy"). Stock and
// prices live on its variants, not here. A plain item with no sizes/classes is
// just an item with a single variant whose label is null.
model InventoryItem {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  sku          String? // optional stock-keeping unit / code
  category     String? // legacy free-text category (kept for back-compat)
  categoryId   String? // structured category
  unit         String? // pcs, kg, box
  variantLabel String? // axis name for variants ("Size", "Class"); null = plain item
  isSellable   Boolean   @default(true)
  purchaseDate DateTime?
  condition    String? // New, Good, Fair, Poor
  location     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school      School                   @relation(fields: [schoolId], references: [id])
  categoryRef InventoryCategory?       @relation(fields: [categoryId], references: [id])
  variants    InventoryItemVariant[]
  movements   InventoryStockMovement[]
  saleItems   InventorySaleItem[]

  @@index([schoolId])
  @@index([categoryId])
}

// A stock-keeping unit under an item: one size of a shirt, one class's book set,
// or the single default variant (label = null) of a plain item. Holds the
// authoritative on-hand quantity and prices for that unit.
model InventoryItemVariant {
  id           String    @id @default(cuid())
  schoolId     String
  itemId       String
  label        String? // "24", "Class V"; null for a plain item's default variant
  sku          String?
  quantity     Int       @default(0) // authoritative current on-hand stock
  reorderLevel Int       @default(0) // low-stock threshold (0 = no alert)
  unitPrice    Float? // cost price (purchase)
  sellingPrice Float? // price charged to students on sale
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school    School                   @relation(fields: [schoolId], references: [id])
  item      InventoryItem            @relation(fields: [itemId], references: [id])
  movements InventoryStockMovement[]
  saleItems InventorySaleItem[]

  @@index([schoolId])
  @@index([itemId])
}

model InventoryCategory {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school School          @relation(fields: [schoolId], references: [id])
  items  InventoryItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Append-only stock ledger. Current stock lives on InventoryItemVariant.quantity
// (maintained transactionally); this table is the audit trail of every change.
model InventoryStockMovement {
  id            String   @id @default(cuid())
  schoolId      String
  itemId        String // parent item (kept for grouping / reporting)
  variantId     String // the variant whose stock changed
  type          String // IN | OUT | ADJUST | SALE | RETURN
  quantity      Int // positive magnitude of the change
  balanceAfter  Int // variant.quantity after applying this movement
  unitCost      Float? // for IN movements (purchase cost)
  reason        String?
  referenceType String? // purchase | sale | return | adjustment
  referenceId   String? // e.g. InventorySale id
  performedBy   String?
  createdAt     DateTime @default(now())

  school  School               @relation(fields: [schoolId], references: [id])
  item    InventoryItem        @relation(fields: [itemId], references: [id])
  variant InventoryItemVariant @relation(fields: [variantId], references: [id])

  @@index([schoolId])
  @@index([itemId])
  @@index([variantId])
  @@index([referenceId])
  @@index([createdAt])
}

// A point-of-sale transaction selling inventory items to a student. The charge
// posts to the student fee ledger (sourceType='inventory') and is paid in the
// same transaction, producing a receipt via the shared fee receipt sequence.
model InventorySale {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  receiptNumber String
  saleDate      DateTime  @default(now())
  subtotal      Float     @default(0)
  discount      Float     @default(0)
  totalAmount   Float     @default(0)
  paymentMethod String    @default("cash") // cash | bank | adjustment
  academicYear  String?
  status        String    @default("completed") // completed | voided
  notes         String?
  soldBy        String?
  ledgerDebitId String? // DEBIT ledger entry created for this sale
  paymentId     String? // StudentFeePayment created for this sale
  voidedAt      DateTime?
  voidedBy      String?
  voidReason    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school  School                @relation(fields: [schoolId], references: [id])
  student Student               @relation(fields: [studentId], references: [id])
  items   InventorySaleItem[]
  returns InventorySaleReturn[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([saleDate])
  @@index([status])
}

model InventorySaleItem {
  id           String  @id @default(cuid())
  saleId       String
  itemId       String
  variantId    String
  itemName     String // snapshot at sale time
  variantLabel String? // snapshot of the variant label at sale time
  quantity     Int
  unitPrice    Float
  lineTotal    Float
  returnedQty  Int     @default(0)

  sale    InventorySale        @relation(fields: [saleId], references: [id])
  item    InventoryItem        @relation(fields: [itemId], references: [id])
  variant InventoryItemVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([itemId])
  @@index([variantId])
}

// A (partial) return against a sale: restocks items and writes a refund/credit
// reversal to the student ledger.
model InventorySaleReturn {
  id            String   @id @default(cuid())
  schoolId      String
  saleId        String
  returnDate    DateTime @default(now())
  refundAmount  Float    @default(0)
  reason        String?
  performedBy   String?
  ledgerEntryId String? // ledger reversal entry written for this return
  itemsJson     String? // JSON snapshot of returned [{saleItemId, quantity, refund}]
  createdAt     DateTime @default(now())

  school School        @relation(fields: [schoolId], references: [id])
  sale   InventorySale @relation(fields: [saleId], references: [id])

  @@index([schoolId])
  @@index([saleId])
}

// ============================================
// PETTY CASH
// ============================================

model PettyCashEntry {
  id             String   @id @default(cuid())
  schoolId       String
  amount         Float
  type           String // credit, debit
  category       String?
  description    String?
  createdBy      String
  approvedBy     String?
  approvalStatus String   @default("pending") // pending, approved, rejected
  // Admin created = auto approve, Teacher created = needs approval
  date           DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// ============================================
// NOTIFICATIONS & COMMUNICATION
// ============================================

model Notification {
  id        String   @id @default(cuid())
  schoolId  String?
  userId    String?
  title     String
  message   String
  type      String   @default("info") // info, warning, alert, fee, attendance
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([userId, isRead, createdAt])
  @@index([schoolId, createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  schoolId  String
  title     String
  content   String
  audience  String    @default("all") // all, teachers, students, parents
  priority  String    @default("normal") // normal, high, urgent
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// ============================================
// SUPPORT TICKETS
// ============================================

model SupportTicket {
  id          String   @id @default(cuid())
  schoolId    String?
  userId      String
  subject     String
  description String
  category    String?
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("open") // open, in_progress, resolved, closed
  assignedTo  String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([status])
}

// ============================================
// RBAC - ROLE BASED ACCESS CONTROL
// ============================================

// Master permission catalog - defines all available permissions in the system
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "student:read", "student:create", "fees:collect"
  name        String // e.g., "View Students", "Create Student", "Collect Fees"
  module      String // e.g., "students", "fees", "attendance", "salary"
  description String?
  action      String // read, create, update, delete, *
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions   RolePermission[]
  schoolPermissions SchoolPermission[]
  userPermissions   UserPermission[]

  @@index([module])
  @@index([code])
}

// Custom role defined per school (school admin creates these)
model Role {
  id          String    @id @default(cuid())
  schoolId    String
  name        String // e.g., "Head Teacher", "Library Staff", "Office Staff", "Receptionist"
  description String?
  color       String? // UI color for badge
  isSystem    Boolean   @default(false) // System roles can't be deleted
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school      School           @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Links a role to specific permissions
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Permissions granted to a school by super admin (controls what school admin can do)
model SchoolPermission {
  id           String   @id @default(cuid())
  schoolId     String
  permissionId String
  grantedBy    String // Super admin user id
  grantedAt    DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([schoolId, permissionId])
  @@index([schoolId])
  @@index([permissionId])
}

// Direct permissions assigned to a user (overrides role permissions)
model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true) // true = grant, false = deny (deny overrides grant)
  grantedBy    String // Who assigned this permission
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// Links a user to a role within their school
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String // Who assigned this role
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ============================================
// AUTH AUDIT & SECURITY
// ============================================

// Every login attempt (success or failure) gets one row. Used for security
// audits, "recent activity" UI, anomaly detection, and post-incident forensics.
model LoginEvent {
  id            String   @id @default(cuid())
  userId        String? // null when email/phone doesn't match any user
  email         String? // captured even for unknown users — useful for spotting credential stuffing
  schoolId      String? // for tenant-scoped reporting
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String? // 'BAD_PASSWORD' | 'USER_NOT_FOUND' | 'INACTIVE' | 'DELETED' | 'RATE_LIMITED' | 'LOCKED'
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([success, createdAt])
  @@index([schoolId, createdAt])
}

// Tracks failed-login streak per user. Reset on successful login. Locks the
// account for a window after too many failures to defeat brute-force attempts.
model AccountLockout {
  userId         String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  // Audit: last manual unlock — who & when. Overwritten on each unlock; for
  // full history, consult LoginEvent rows around the unlockedAt timestamp.
  unlockedBy     String?
  unlockedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
}

// One-time password-reset tokens. The raw token is emailed to the user; only
// its SHA-256 hash is persisted, so a DB compromise reveals nothing usable.
// Single-use (usedAt) + short TTL (30 min). On a successful reset, all other
// unused tokens for the user are marked used in the same transaction.
model PasswordResetToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  channel      String    @default("EMAIL") // EMAIL | WHATSAPP
  attemptCount Int       @default(0) // OTP verification attempts; capped at 5
  expiresAt    DateTime
  usedAt       DateTime?
  requestedIp  String
  requestedUa  String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, channel, usedAt])
  @@index([expiresAt])
}

// ============================================
// CONTACT / DEMO REQUESTS
// ============================================

model ContactRequest {
  id           String    @id @default(cuid())
  name         String
  schoolName   String
  email        String
  phone        String
  studentCount Int       @default(0)
  message      String?
  addOns       String? // JSON array of selected add-ons: ["salary_payroll", "priority_support", "custom_branding", "school_landing_page"]
  status       String    @default("new") // new, contacted, qualified, converted, lost
  notes        String? // Admin notes
  contactedBy  String? // Super admin user id who contacted
  contactedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================
// LANDING PAGE TESTIMONIALS
// ============================================

model Testimonial {
  id        String    @id @default(cuid())
  name      String
  role      String // e.g., "Principal, DPS Delhi"
  quote     String
  stars     Int       @default(5)
  avatarUrl String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================
// LANDING PAGE PRICING
// ============================================

model PricingPlan {
  id              String    @id @default(cuid())
  name            String // e.g., "Base Plan"
  pricePerStudent Float     @default(10) // Price per student per month
  billingCycle    String    @default("monthly") // monthly, yearly
  description     String? // Short description
  features        String // JSON array of feature strings, e.g. ["Feature 1", "Feature 2"]
  highlights      String? // JSON array of highlight strings shown on the left side, e.g. ["Data migration included"]
  isActive        Boolean   @default(true)
  isPopular       Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

model PricingAddon {
  id          String    @id @default(cuid())
  name        String // e.g., "Salary & Payroll"
  description String // What this addon includes
  icon        String // Lucide icon name, e.g. "Wallet", "Crown", "Palette", "Globe"
  price       Float // Price amount
  priceLabel  String // e.g., "per staff / month", "one-time"
  type        String    @default("one_time") // recurring, one_time
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================
// LANDING PAGE TEAM MEMBERS
// ============================================

model TeamMember {
  id        String    @id @default(cuid())
  name      String // e.g., "Manish Kumar"
  role      String // e.g., "Developer", "Marketing Head"
  bio       String // Short bio/description
  image     String? // Image URL or path
  phone     String? // Contact phone
  email     String? // Contact email
  linkedin  String? // LinkedIn profile URL
  twitter   String? // X/Twitter profile URL
  github    String? // GitHub profile URL
  instagram String? // Instagram profile URL
  facebook  String? // Facebook profile URL
  website   String? // Personal website URL
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================
// STUDENT ID CARD MODULE
// ============================================
// Per-school templates that admins design via the in-app editor. The visual
// layout is stored as JSON (front + optional back) so the same template can
// be re-rendered on screen, printed, and saved to PDF without ever drifting
// from the source of truth. Tenant-scoped via schoolId; soft-delete via
// deletedAt to keep prior generation logs auditable.
model IdCardTemplate {
  id              String    @id @default(cuid())
  schoolId        String
  name            String
  description     String?
  // "html"  → frontHtml/frontCss authoring (modern path, post 2026-06-02)
  // "element" → legacy click-to-add element list stored in frontLayout/backLayout
  templateMode    String    @default("html")
  orientation     String    @default("portrait") // portrait | landscape
  widthMm         Float     @default(86)
  heightMm        Float     @default(54)
  backgroundColor String    @default("#ffffff")
  frontBackground String?
  backBackground  String?
  frontLayout     String    @default("[]") // legacy element JSON
  backLayout      String?
  frontHtml       String?
  backHtml        String?
  frontCss        String?
  backCss         String?
  hasBackSide     Boolean   @default(false)
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  school         School                @relation(fields: [schoolId], references: [id])
  generationLogs IdCardGenerationLog[]

  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, isDefault])
}

// Audit row written every time a batch of cards is previewed/printed/downloaded.
model IdCardGenerationLog {
  id           String   @id @default(cuid())
  schoolId     String
  templateId   String
  generatedBy  String?
  studentCount Int
  studentIds   String // JSON array of student IDs included in this run
  academicYear String?
  action       String   @default("preview") // preview | print | download
  createdAt    DateTime @default(now())

  school   School         @relation(fields: [schoolId], references: [id])
  template IdCardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([templateId])
  @@index([createdAt])
}
