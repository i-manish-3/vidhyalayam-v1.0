// Multi-tenant SaaS School Management ERP System
// All tables include tenant_id (school_id) for data isolation
// Soft delete supported via deleted_at

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USER MANAGEMENT
// ============================================

model User {
  id                    String    @id @default(cuid())
  employeeId            String?
  email                 String    @unique
  password              String
  name                  String
  phone                 String?
  avatar                String?
  dob                   DateTime?
  drivingLicenseNumber  String?
  mustChangePassword    Boolean   @default(false)
  role                  String // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT
  schoolId              String?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  impersonatingSchoolId String? // SUPER_ADMIN only — active impersonation target
  // Bumped on password change to invalidate every outstanding session. JWTs
  // carry `tv` in their payload; refresh re-reads this and rejects mismatches.
  tokenVersion          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  school              School?               @relation(fields: [schoolId], references: [id])
  userRoles           UserRole[]
  userPermissions     UserPermission[]
  markedAttendance    Attendance[]          @relation("markedByUser")
  attendanceAuditLogs AttendanceAuditLog[]  @relation("attendanceAuditActor")
  attendanceChanges   AttendanceChangeLog[] @relation("attendanceChanger")
  loginEvents         LoginEvent[]
  accountLockout      AccountLockout?
  passwordResetTokens PasswordResetToken[]
  feeAuditLogs        FeeAuditLog[]
  feeConfigAuditLogs  FeeConfigAuditLog[]

  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([role])
}

// ============================================
// SCHOOL / TENANT MANAGEMENT
// ============================================

model School {
  id             String    @id @default(cuid())
  name           String
  logo           String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  country        String    @default("India")
  contactPhone   String?
  contactEmail   String?
  website        String?
  academicYear   String    @default("2025-2026")
  board          String    @default("CBSE") // CBSE, ICSE, State
  timezone       String    @default("Asia/Kolkata")
  currency       String    @default("INR")
  subdomain      String    @unique
  status         String    @default("pending") // pending, active, suspended, trial
  trialEndsAt    DateTime?
  onboardingDate DateTime?
  favicon        String?
  printHeader    String? // Base64 banner image used as header on all printables (admission form, fee receipt, etc.)
  primaryColor   String?
  dashboardFont  String?   @default("system")
  features       String? // JSON string of enabled features
  workingDays    String    @default("[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"]") // JSON array of weekday names this school operates on
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  users                       User[]
  classes                     Class[]
  sections                    Section[]
  subjects                    Subject[]
  students                    Student[]
  teachers                    Teacher[]
  drivers                     Driver[]
  staff                       Staff[]
  parents                     Parent[]
  feesHeads                   FeesHead[]
  feesGroups                  FeesGroup[]
  feesStructures              FeesStructure[]
  feeCollections              FeeCollection[]
  studentFeeAssignments       StudentFeeAssignment[]
  studentFeeInvoices          StudentFeeInvoice[]
  studentFeePayments          StudentFeePayment[]
  studentFeeLedgerEntries     StudentFeeLedgerEntry[]
  studentFeeLedgerAllocations StudentFeeLedgerAllocation[]
  feeAuditLogs                FeeAuditLog[]
  feeConfigAuditLogs          FeeConfigAuditLog[]
  studentWithdrawals          StudentWithdrawal[]
  studentFeeRefunds           StudentFeeRefund[]
  transportEvents             TransportEvent[]
  attendance                  Attendance[]
  attendanceAuditLogs         AttendanceAuditLog[]
  attendanceChanges           AttendanceChangeLog[]
  timetables                  Timetable[]
  periodConfigs               PeriodConfig[]
  exams                       Exam[]
  examResults                 ExamResult[]
  transportRoutes             TransportRoute[]
  libraryBooks                LibraryBook[]
  bookIssues                  BookIssue[]
  inventoryItems              InventoryItem[]
  pettyCash                   PettyCashEntry[]
  notifications               Notification[]
  salaryStructures            SalaryStructure[]
  salaryPayments              SalaryPayment[]
  advanceRequests             AdvanceRequest[]
  announcements               Announcement[]
  supportTickets              SupportTicket[]
  admissions                  Admission[]
  admissionSetting            AdmissionSetting?
  studentAcademicEnrollments  StudentAcademicEnrollment[]
  academicYears               AcademicYear[]
  classTeacherAssignments     ClassTeacherAssignment[]
  schoolPermissions           SchoolPermission[]
  roles                       Role[]
  holidays                    Holiday[]
  feeDemandConfig             FeeDemandConfig?
  feeDemandRuns               FeeDemandRun[]
  feeNotifications            FeeNotification[]

  @@index([subdomain])
  @@index([status])
}

// ============================================
// ACADEMIC STRUCTURE
// ============================================

model AcademicYear {
  id        String    @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isCurrent])
  @@index([isActive])
}

model Holiday {
  id           String    @id @default(cuid())
  schoolId     String
  academicYear String
  date         DateTime // start date (inclusive)
  endDate      DateTime? // end date (inclusive); null = single-day holiday
  name         String
  type         String    @default("school") // public | school | vacation
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, academicYear])
  @@index([date])
}

model Class {
  id        String    @id @default(cuid())
  schoolId  String
  name      String // Class 1, Class 2, ... Class 12, Nursery, LKG, UKG (required)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school                     School                      @relation(fields: [schoolId], references: [id])
  sections                   Section[]
  students                   Student[]
  studentAcademicEnrollments StudentAcademicEnrollment[]
  feesStructures             FeesStructure[]
  feeAssignments             StudentFeeAssignment[]
  classSubjects              ClassSubject[]
  classTeacherAssignments    ClassTeacherAssignment[]

  @@index([schoolId])
}

model Section {
  id        String    @id @default(cuid())
  schoolId  String
  classId   String
  name      String // A, B, C, D
  teacherId String? // Class teacher
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school                     School                      @relation(fields: [schoolId], references: [id])
  class                      Class                       @relation(fields: [classId], references: [id])
  students                   Student[]
  studentAcademicEnrollments StudentAcademicEnrollment[]
  timetables                 Timetable[]
  feesStructures             FeesStructure[]
  feeAssignments             StudentFeeAssignment[]
  classTeacherAssignments    ClassTeacherAssignment[]

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([classId])
}

model ClassTeacherAssignment {
  id           String    @id @default(cuid())
  schoolId     String
  academicYear String
  classId      String
  sectionId    String?
  teacherId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school  School   @relation(fields: [schoolId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
  teacher Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([schoolId, academicYear, sectionId])
  @@index([schoolId, academicYear])
  @@index([classId])
  @@index([teacherId])
}

model Subject {
  id         String    @id @default(cuid())
  schoolId   String
  name       String
  code       String?
  sequenceNo Int?
  type       String    @default("primary") // primary, optional, extra, special
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  school        School         @relation(fields: [schoolId], references: [id])
  timetables    Timetable[]
  exams         Exam[]
  classSubjects ClassSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

// ============================================
// PEOPLE MANAGEMENT
// ============================================

model Student {
  id                String    @id @default(cuid())
  schoolId          String
  classId           String?
  sectionId         String?
  admissionNumber   String?   @unique
  rollNumber        String?
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            String? // Male, Female, Other
  nationality       String?   @default("Indian")
  religion          String?
  category          String? // General, OBC, SC, ST, EWS
  motherTongue      String?
  aadhaarNumber     String?
  bloodGroup        String?
  medicalConditions String? // JSON: allergies, conditions, medications
  address           String?
  city              String?
  state             String?
  pincode           String?
  country           String?   @default("India")
  profileImage      String?
  admissionDate     DateTime?
  previousSchool    String?
  previousSchoolTC  String? // TC number
  previousClass     String? // Last attended class
  previousResult    String? // Pass/Fail/Percentage
  transferCertNo    String? // TC issued by this school
  siblingId         String? // Link to sibling student (historical breadcrumb; family group lives in familyId)
  familyId          String? // Shared id across all members of one family
  admissionStatus   String    @default("admitted") // admitted, promoted, detained, transferred, alumni, withdrawn
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  school               School                       @relation(fields: [schoolId], references: [id])
  class                Class?                       @relation(fields: [classId], references: [id])
  section              Section?                     @relation(fields: [sectionId], references: [id])
  parentLinks          StudentParent[]
  attendance           Attendance[]
  attendanceChanges    AttendanceChangeLog[]
  feeCollections       FeeCollection[]
  feeAssignments       StudentFeeAssignment[]
  academicEnrollments  StudentAcademicEnrollment[]
  feeInvoices          StudentFeeInvoice[]
  feePayments          StudentFeePayment[]
  feeLedgerEntries     StudentFeeLedgerEntry[]
  feeLedgerAllocations StudentFeeLedgerAllocation[]
  examResults          ExamResult[]
  admission            Admission?
  withdrawals          StudentWithdrawal[]
  feeRefunds           StudentFeeRefund[]
  feeAuditLogs         FeeAuditLog[]

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([admissionNumber])
  @@index([admissionStatus])
  @@index([familyId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, admissionStatus])
}

model StudentAcademicEnrollment {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  academicYear   String
  classId        String
  sectionId      String?
  rollNumber     String?
  status         String    @default("active") // active, promoted, detained, transferred, withdrawn
  source         String    @default("admission") // admission, promotion, manual
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  promotedFromId String?
  remarks        String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school  School   @relation(fields: [schoolId], references: [id])
  student Student  @relation(fields: [studentId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@unique([studentId, academicYear])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([classId])
  @@index([sectionId])
  @@index([status])
}

// ============================================
// ADMISSION MODULE
// ============================================

model Admission {
  id              String  @id @default(cuid())
  schoolId        String
  studentId       String? @unique // Linked after student creation
  admissionNumber String? // Auto-generated: STD-2025-001
  academicYear    String  @default("2025-2026")
  admissionType   String  @default("new") // new, transfer, re-admission
  status          String  @default("applied") // applied, documents_verified, fee_pending, admitted, rejected, withdrawn, waitlisted

  // Personal Info (Tab 1)
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  dateOfAdmission    DateTime? // Date of admission
  gender             String? // Boy, Girl, Other
  nationality        String?   @default("Indian")
  religion           String?
  category           String? // General, OBC, SC, ST, EWS
  caste              String? // Sub-caste
  motherTongue       String?
  aadhaarNumber      String?
  bloodGroup         String?
  medicalConditions  String? // JSON
  profileImage       String?
  registrationNumber String? // Registration No / Admission No (manual)
  penNumber          String? // PEN / Government ID
  samagraId          String?
  apaarId            String?
  udiseId            String?
  heightCm           Float? // Height in CMs
  weightKg           Float? // Weight in KGs

  // Contact / Address (Tab 2)
  address            String? // Permanent / Official Address (Street, Landmark, Area)
  city               String?
  state              String?
  pincode            String?
  country            String? @default("India")
  village            String? // Village / Post
  postOffice         String?
  policeStation      String?
  wardNo             String?
  localAddress       String? // Local / Residential Address
  localVillage       String?
  localPostOffice    String?
  localPoliceStation String?
  localWardNo        String?
  localCity          String?
  localState         String?
  localPincode       String?
  localCountry       String?
  sameAsPermanent    Boolean @default(true) // Local same as permanent

  // Mother's Info (Tab 2)
  motherName       String?
  motherPhone      String?
  motherEmail      String?
  motherOccupation String?
  motherAadhaar    String?
  motherEducation  String? // Educational Qualification
  motherIncome     Float? // Yearly Income

  // Father's Info (Tab 2)
  fatherName       String?
  fatherPhone      String?
  fatherEmail      String?
  fatherOccupation String?
  fatherAadhaar    String?
  fatherEducation  String? // Educational Qualification
  fatherIncome     Float? // Yearly Income

  // Other Details (Tab 2)
  belongsToEws      Boolean @default(false) // Belongs to EWS
  isSingleGirlChild Boolean @default(false)
  isDivyangian      Boolean @default(false) // Divyangian (differently abled)

  // General Details (Tab 3)
  classId             String? // Class Admitted
  sectionId           String?
  admissionSession    String? // Admission Session
  mediumOfInstruction String? // Language medium
  area                String? // Rural, Urban, Semi-Urban

  // Last Institution Details (Tab 3)
  previousSchool        String? // Institution Name
  previousSchoolAddress String? // Institution Address
  previousClass         String? // Class Last Attended
  previousResult        String? // Result of Last Class
  affiliatedTo          String? // Affiliated To
  previousSchoolTC      String? // TC Number
  tcDate                DateTime? // TC Date

  // Transport Details (Tab 3)
  transportRouteId String?
  transportStop    String?

  // Hostel Details (Tab 3)
  hostelName   String?
  hostelRoomNo String?
  hostelBedNo  String?

  // Accounts Info (Tab 4)
  bankAccountNumber  String?
  ifscCode           String?
  monthlyFeeDiscount Float?  @default(0) // Monthly Fee Discount Amount
  feeId              String? // Fee ID
  concessionNo       String? // Concession No.
  transportDiscount  Float?  @default(0) // Transport Discount Amount
  feesGroupId        String? // Fee Group

  // Family
  annualIncome Float?
  siblingId    String? // Sibling already in school (historical breadcrumb; family group lives in familyId)
  familyId     String? // Shared id across all members of one family

  // Parent address
  sameAddressAsStudent Boolean @default(true)
  fatherAddress        String?
  motherAddress        String?

  // Concession & Source
  concessionType   String? // sibling, staff, scholarship, other
  concessionReason String?
  sourceOfInfo     String? // newspaper, website, referral, walk_in, other
  formNumber       String? // Physical form number

  // Admission workflow
  appliedDate      DateTime  @default(now())
  verifiedBy       String?
  verifiedAt       DateTime?
  admittedBy       String?
  admittedAt       DateTime?
  rejectedReason   String?
  waitlistPosition Int?

  // Additional
  remarks   String?
  createdBy String? // User who created the application
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school     School              @relation(fields: [schoolId], references: [id])
  student    Student?            @relation(fields: [studentId], references: [id])
  documents  AdmissionDocument[]
  notes      AdmissionNote[]
  activities AdmissionActivity[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, registrationNumber])
  @@index([schoolId])
  @@index([status])
  @@index([classId])
  @@index([familyId])
}

// Per-school, per-kind, per-year counter for admission/registration/employee numbers.
// Row-level lock on UPDATE ... increment serializes allocation so two
// simultaneous records can never receive the same sequence number, and the
// increment rolls back with the surrounding transaction (no gaps from
// abandoned transactions).
model NumberCounter {
  schoolId  String
  kind      String // 'admission' | 'registration' | 'employee'
  year      Int // calendar year of dateOfAdmission; or 0 when resetYearly is false
  lastValue Int // last sequence number allocated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([schoolId, kind, year])
}

model AdmissionDocument {
  id                 String    @id @default(cuid())
  admissionId        String
  documentType       String // birth_certificate, aadhaar, transfer_cert, marksheet, passport_photo, caste_cert, income_cert, migration_cert, character_cert, other
  documentName       String
  fileUrl            String? // File path/URL
  fileSize           Int? // In KB
  fileType           String? // image/jpeg, application/pdf, etc.
  uploadedAt         DateTime?
  verificationStatus String    @default("pending") // pending, verified, rejected
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  isRequired         Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
  @@index([documentType])
  @@index([verificationStatus])
}

model AdmissionNote {
  id          String   @id @default(cuid())
  admissionId String
  note        String
  noteType    String   @default("general") // general, phone_call, email, visit, follow_up
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
}

model AdmissionActivity {
  id          String   @id @default(cuid())
  admissionId String
  action      String // created, status_changed, document_uploaded, document_verified, document_rejected, note_added, field_updated, admitted, rejected
  fromValue   String? // Previous value (for status changes)
  toValue     String? // New value
  performedBy String
  description String?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
  @@index([action])
  @@index([createdAt])
}

model AdmissionSetting {
  id                         String    @id @default(cuid())
  schoolId                   String    @unique
  admissionNumberPrefix      String    @default("STD")
  admissionNumberFormat      String    @default("{PREFIX}-{YEAR}-{SEQ}") // {PREFIX}, {YEAR}, {SEQ}, {CLASS}
  registrationNumberPrefix   String    @default("REG")
  registrationNumberFormat   String    @default("{PREFIX}-{YEAR}-{SEQ}") // {PREFIX}, {YEAR}, {YY}, {SEQ}, {CLASS}
  registrationSequenceStart  Int       @default(1)
  registrationSequenceDigits Int       @default(3)
  registrationResetYearly    Boolean   @default(true)
  employeeNumberPrefix       String    @default("EMP")
  employeeNumberFormat       String    @default("{PREFIX}-{SEQ}") // {PREFIX}, {YEAR}, {YY}, {SEQ}
  employeeSequenceStart      Int       @default(1)
  employeeSequenceDigits     Int       @default(4)
  employeeResetYearly        Boolean   @default(false)
  sequenceStart              Int       @default(1)
  sequenceDigits             Int       @default(3) // 001, 0001, etc.
  resetSequenceYearly        Boolean   @default(true)
  academicYear               String    @default("2025-2026")
  admissionOpenDate          DateTime?
  admissionCloseDate         DateTime?
  minAge                     Int       @default(3)
  maxAge                     Int       @default(18)
  ageCalculationDate         String    @default("april_1") // april_1, july_1, admission_date
  requiredDocuments          String? // JSON array of required document types
  customFields               String? // JSON array of custom field definitions
  allowOnlineSubmission      Boolean   @default(false)
  requirePhoto               Boolean   @default(true)
  requireAadhaar             Boolean   @default(false)
  maxApplicationsPerClass    Int?
  enableWaitlist             Boolean   @default(true)
  autoVerifyDocuments        Boolean   @default(false)
  admissionFeeRequired       Boolean   @default(true)
  formFeeAmount              Float     @default(0)
  notificationEmails         String? // JSON array of email templates config
  printTemplate              String? // JSON for print layout
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Teacher {
  id             String    @id @default(cuid())
  schoolId       String
  userId         String?
  employeeId     String?
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  aadhaarNumber  String?
  qualification  String?
  specialization String?
  experience     Int       @default(0)
  joinDate       DateTime?
  profileImage   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school                  School                   @relation(fields: [schoolId], references: [id])
  timetables              Timetable[]
  classTeacherAssignments ClassTeacherAssignment[]
  salaryStructure         SalaryStructure?
  salaryPayments          SalaryPayment[]
  advanceRequests         AdvanceRequest[]

  @@index([schoolId])
  @@index([schoolId, employeeId])
}

model Driver {
  id                   String    @id @default(cuid())
  schoolId             String
  userId               String?
  employeeId           String?
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  gender               String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  drivingLicenseNumber String?
  joinDate             DateTime?
  profileImage         String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([userId])
}

model Staff {
  id            String    @id @default(cuid())
  schoolId      String
  userId        String?
  employeeId    String?
  firstName     String
  lastName      String
  gender        String?
  dateOfBirth   DateTime?
  joinDate      DateTime?
  designation   String?
  department    String?
  qualification String?
  experience    Int       @default(0)
  address       String?
  city          String?
  state         String?
  pincode       String?
  aadhaarNumber String?
  profileImage  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([userId])
}

model Parent {
  id             String    @id @default(cuid())
  schoolId       String
  userId         String?
  fatherName     String?
  motherName     String?
  phone          String?
  alternatePhone String?
  email          String?
  occupation     String?
  address        String?
  annualIncome   Float?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school   School          @relation(fields: [schoolId], references: [id])
  children StudentParent[]

  @@index([schoolId])
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  relation  String // Father, Mother
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  parent  Parent  @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
}

// ============================================
// FEES MANAGEMENT SYSTEM
// ============================================

model FeesHead {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  frequency     String // ONE_TIME, MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY, CUSTOM
  headType      String    @default("STANDARD") // STANDARD, REFUNDABLE_DEPOSIT, NON_REFUNDABLE
  isOptional    Boolean   @default(false)
  applicability String? // JSON rules for gender/category/student type/etc.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school          School                     @relation(fields: [schoolId], references: [id])
  groupItems      FeesGroupItem[]
  structureItems  FeesStructureItem[]
  assignmentItems StudentFeeAssignmentItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model FeesGroup {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school      School                 @relation(fields: [schoolId], references: [id])
  items       FeesGroupItem[]
  structures  FeesStructure[]
  assignments StudentFeeAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model FeesGroupItem {
  id        String   @id @default(cuid())
  groupId   String
  feeHeadId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   FeesGroup @relation(fields: [groupId], references: [id])
  feeHead FeesHead  @relation(fields: [feeHeadId], references: [id])

  @@unique([groupId, feeHeadId])
}

model FeesStructure {
  id            String    @id @default(cuid())
  schoolId      String
  feesGroupId   String
  classId       String
  sectionId     String?
  academicYear  String
  name          String
  version       Int       @default(1)
  status        String    @default("active") // draft, active, archived
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  lockedAt      DateTime?
  lockedBy      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school      School                 @relation(fields: [schoolId], references: [id])
  feesGroup   FeesGroup              @relation(fields: [feesGroupId], references: [id])
  class       Class                  @relation(fields: [classId], references: [id])
  section     Section?               @relation(fields: [sectionId], references: [id])
  items       FeesStructureItem[]
  assignments StudentFeeAssignment[]

  @@index([schoolId])
  @@index([classId])
  @@index([academicYear])
  @@index([feesGroupId])
}

model FeesStructureItem {
  id              String    @id @default(cuid())
  feeStructureId  String
  feeHeadId       String
  installmentName String // Jan, Feb, Mar, Q1, H1, Annual, etc.
  amount          Float     @default(0)
  dueDate         DateTime?
  lateFee         Float     @default(0)
  frequency       String // Derived from fee head
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  feeStructure    FeesStructure              @relation(fields: [feeStructureId], references: [id])
  feeHead         FeesHead                   @relation(fields: [feeHeadId], references: [id])
  assignmentItems StudentFeeAssignmentItem[]

  @@index([feeStructureId])
  @@index([feeHeadId])
}

model FeeCollection {
  id                         String    @id @default(cuid())
  schoolId                   String
  studentId                  String
  feeStructureItemId         String?
  studentFeeAssignmentItemId String?
  studentFeeInvoiceId        String?
  amount                     Float
  paidAmount                 Float     @default(0)
  discount                   Float     @default(0)
  concession                 Float     @default(0)
  scholarship                Float     @default(0)
  fine                       Float     @default(0)
  paymentStatus              String    @default("unpaid") // unpaid, partial, paid
  paymentMethod              String? // cash, online, cheque, upi
  transactionRef             String?
  paymentDate                DateTime?
  receiptNumber              String?
  dueDate                    DateTime?
  installmentName            String?
  feeHeadName                String?
  notes                      String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  school         School                    @relation(fields: [schoolId], references: [id])
  student        Student                   @relation(fields: [studentId], references: [id])
  assignmentItem StudentFeeAssignmentItem? @relation(fields: [studentFeeAssignmentItemId], references: [id])
  invoice        StudentFeeInvoice?        @relation(fields: [studentFeeInvoiceId], references: [id])
  ledgerEntries  StudentFeeLedgerEntry[]

  @@index([schoolId])
  @@index([studentId])
  @@index([paymentStatus])
  @@index([feeStructureItemId])
  @@index([studentFeeAssignmentItemId])
  @@index([studentFeeInvoiceId])
}

model StudentFeeAssignment {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  feeStructureId String
  feesGroupId    String
  classId        String
  sectionId      String?
  academicYear   String
  name           String
  source         String    @default("manual") // admission, promotion, manual, migration
  status         String    @default("active") // active, paused, closed
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  assignedBy     String?
  assignedAt     DateTime  @default(now())
  snapshotJson   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school        School                     @relation(fields: [schoolId], references: [id])
  student       Student                    @relation(fields: [studentId], references: [id])
  feeStructure  FeesStructure              @relation(fields: [feeStructureId], references: [id])
  feesGroup     FeesGroup                  @relation(fields: [feesGroupId], references: [id])
  class         Class                      @relation(fields: [classId], references: [id])
  section       Section?                   @relation(fields: [sectionId], references: [id])
  items         StudentFeeAssignmentItem[]
  invoices      StudentFeeInvoice[]
  ledgerEntries StudentFeeLedgerEntry[]

  @@unique([studentId, feeStructureId, academicYear])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([status])
}

model StudentFeeAssignmentItem {
  id                 String    @id @default(cuid())
  assignmentId       String
  feeStructureItemId String?
  feeHeadId          String?
  feeHeadName        String
  billingBehavior    String
  installmentName    String
  amount             Float     @default(0)
  dueDate            DateTime?
  lateFee            Float     @default(0)
  headType           String    @default("STANDARD")
  isOptional         Boolean   @default(false)
  status             String    @default("active") // active, waived, cancelled, billed
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignment       StudentFeeAssignment    @relation(fields: [assignmentId], references: [id])
  feeStructureItem FeesStructureItem?      @relation(fields: [feeStructureItemId], references: [id])
  feeHead          FeesHead?               @relation(fields: [feeHeadId], references: [id])
  invoiceLines     StudentFeeInvoiceLine[]
  feeCollections   FeeCollection[]
  ledgerEntries    StudentFeeLedgerEntry[]

  @@index([assignmentId])
  @@index([feeStructureItemId])
  @@index([feeHeadId])
}

model StudentFeeInvoice {
  id                   String    @id @default(cuid())
  schoolId             String
  studentId            String
  assignmentId         String?
  invoiceNumber        String
  invoiceDate          DateTime  @default(now())
  dueDate              DateTime?
  subtotal             Float     @default(0)
  discount             Float     @default(0)
  concession           Float     @default(0)
  scholarship          Float     @default(0)
  fine                 Float     @default(0)
  totalAmount          Float     @default(0)
  paidAmount           Float     @default(0)
  status               String    @default("unpaid") // unpaid, partial, paid, cancelled
  lockedAt             DateTime?
  lockedBy             String?
  notes                String?
  // Monthly demand slip fields (Phase 1 — populated by Phase 2 generator).
  // For legacy / opening invoices these stay null and isMonthlyDemand=false.
  billingMonth         Int? // 1-12
  billingYear          Int? // e.g. 2026
  isMonthlyDemand      Boolean   @default(false)
  previousBalance      Float     @default(0) // carried-over dues at slip generation time
  generatedBy          String? // userId who triggered (null = system/seed)
  demandRunId          String?
  // Phase 5 — public share link for parent WhatsApp delivery
  publicAccessToken    String?   @unique
  publicTokenExpiresAt DateTime?
  sharedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  school        School                  @relation(fields: [schoolId], references: [id])
  student       Student                 @relation(fields: [studentId], references: [id])
  assignment    StudentFeeAssignment?   @relation(fields: [assignmentId], references: [id])
  demandRun     FeeDemandRun?           @relation(fields: [demandRunId], references: [id])
  lines         StudentFeeInvoiceLine[]
  payments      StudentFeePayment[]
  collections   FeeCollection[]
  ledgerEntries StudentFeeLedgerEntry[]
  notifications FeeNotification[]

  @@unique([schoolId, invoiceNumber])
  @@unique([schoolId, studentId, billingMonth, billingYear, isMonthlyDemand], name: "monthly_demand_unique")
  @@index([schoolId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
  @@index([demandRunId])
  @@index([schoolId, billingYear, billingMonth])
}

model StudentFeeInvoiceLine {
  id               String    @id @default(cuid())
  invoiceId        String
  assignmentItemId String?
  feeHeadName      String
  installmentName  String
  amount           Float     @default(0)
  discount         Float     @default(0)
  concession       Float     @default(0)
  scholarship      Float     @default(0)
  fine             Float     @default(0)
  totalAmount      Float     @default(0)
  dueDate          DateTime?
  status           String    @default("unpaid")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoice        StudentFeeInvoice         @relation(fields: [invoiceId], references: [id])
  assignmentItem StudentFeeAssignmentItem? @relation(fields: [assignmentItemId], references: [id])
  ledgerEntries  StudentFeeLedgerEntry[]

  @@index([invoiceId])
  @@index([assignmentItemId])
}

model StudentFeePayment {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  invoiceId      String?
  amount         Float
  paymentMethod  String
  transactionRef String?
  receiptNumber  String
  paymentDate    DateTime @default(now())
  notes          String?
  receivedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school        School                  @relation(fields: [schoolId], references: [id])
  student       Student                 @relation(fields: [studentId], references: [id])
  invoice       StudentFeeInvoice?      @relation(fields: [invoiceId], references: [id])
  ledgerEntries StudentFeeLedgerEntry[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([invoiceId])
  @@index([schoolId, paymentDate])
}

model StudentFeeLedgerEntry {
  id               String    @id @default(cuid())
  schoolId         String
  studentId        String
  academicYear     String?
  assignmentId     String?
  assignmentItemId String?
  invoiceId        String?
  invoiceLineId    String?
  paymentId        String?
  feeCollectionId  String?
  entryType        String // DEBIT, CREDIT, ADJUSTMENT, FINE, WAIVER, REFUND
  sourceType       String // assignment, transport, payment, adjustment, migration
  sourceId         String?
  feeHeadName      String?
  installmentName  String?
  description      String?
  debit            Float     @default(0)
  credit           Float     @default(0)
  balanceAmount    Float     @default(0)
  dueDate          DateTime?
  transactionDate  DateTime  @default(now())
  paymentMethod    String?
  transactionRef   String?
  receiptNumber    String?
  status           String    @default("open") // open, partial, settled, cancelled
  notes            String?
  createdBy        String?
  version          Int       @default(1) // Optimistic locking: incremented on each balance update
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  school            School                       @relation(fields: [schoolId], references: [id])
  student           Student                      @relation(fields: [studentId], references: [id])
  assignment        StudentFeeAssignment?        @relation(fields: [assignmentId], references: [id])
  assignmentItem    StudentFeeAssignmentItem?    @relation(fields: [assignmentItemId], references: [id])
  invoice           StudentFeeInvoice?           @relation(fields: [invoiceId], references: [id])
  invoiceLine       StudentFeeInvoiceLine?       @relation(fields: [invoiceLineId], references: [id])
  payment           StudentFeePayment?           @relation(fields: [paymentId], references: [id])
  feeCollection     FeeCollection?               @relation(fields: [feeCollectionId], references: [id])
  debitAllocations  StudentFeeLedgerAllocation[] @relation("DebitLedgerEntry")
  creditAllocations StudentFeeLedgerAllocation[] @relation("CreditLedgerEntry")

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([assignmentId])
  @@index([assignmentItemId])
  @@index([invoiceId])
  @@index([invoiceLineId])
  @@index([paymentId])
  @@index([feeCollectionId])
  @@index([entryType])
  @@index([status])
  @@index([dueDate])
  @@index([transactionDate])
}

model StudentFeeLedgerAllocation {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  debitEntryId  String
  creditEntryId String
  amount        Float
  allocatedAt   DateTime  @default(now())
  receiptNumber String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  school      School                @relation(fields: [schoolId], references: [id])
  student     Student               @relation(fields: [studentId], references: [id])
  debitEntry  StudentFeeLedgerEntry @relation("DebitLedgerEntry", fields: [debitEntryId], references: [id])
  creditEntry StudentFeeLedgerEntry @relation("CreditLedgerEntry", fields: [creditEntryId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([debitEntryId])
  @@index([creditEntryId])
  @@index([allocatedAt])
}

model FeeAuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  entityType String   // StudentFeePayment, StudentFeeInvoice, StudentFeeLedgerEntry, StudentFeeRefund, etc.
  entityId   String
  action     String   // created, updated, deleted, payment_recorded, refund_issued, etc.

  // Enhanced fields
  studentId  String?  // Denormalized for fast student-scoped queries
  userId     String?  // Who performed the action
  ipAddress  String?  // Request IP for security audits
  userAgent  String?  // Browser/client info

  // Snapshots
  oldValue   String?  // JSON snapshot before change
  newValue   String?  // JSON snapshot after change
  diffSummary String? // Human-readable summary: "Changed amount from 1000 to 1200"

  // Metadata
  metadata   String?  // JSON: additional context (invoice number, receipt number, etc.)

  createdAt  DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([entityType, entityId])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, userId, createdAt])
  @@index([schoolId, entityType, createdAt])
  @@index([schoolId, action, createdAt])
  @@index([createdAt]) // For retention cleanup
}

model FeeConfigAuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  configType  String   // FeeDemandConfig, FeesStructure, FeesHead, FeesGroup, BillingWindow
  configId    String
  action      String   // created, updated, deleted, activated, deactivated, locked

  userId      String?
  ipAddress   String?
  userAgent   String?

  oldValue    String?  // JSON snapshot before
  newValue    String?  // JSON snapshot after
  diffSummary String?  // "Changed dueDay from 5 to 10"

  metadata    String?  // JSON: affected students count, academic year, etc.

  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([configType, configId])
  @@index([schoolId, configType, createdAt])
  @@index([schoolId, userId, createdAt])
  @@index([createdAt])
}

// Per-school singleton config for monthly fee demand slip generation
// + WhatsApp notification preferences. Mirrors AdmissionSetting pattern.
model FeeDemandConfig {
  id       String @id @default(cuid())
  schoolId String @unique

  // General — when monthly slips are due (1-28 to avoid month-end edge cases)
  dueDay Int @default(10)

  // Slip number format — template with variables: {academicYear}, {subdomain}, {month}, {year}, {sequence}
  slipNumberFormat String @default("DS/{academicYear}/{subdomain}/{month}/{sequence}")

  // Late fine — schema ready, code skips Phase 1
  lateFeeEnabled   Boolean @default(false)
  lateFeeType      String  @default("FLAT") // FLAT | PER_DAY
  lateFeeAmount    Float   @default(0)
  lateFeeGraceDays Int     @default(0)

  // WhatsApp delivery (activated Phase 5)
  whatsappEnabled  Boolean @default(false)
  whatsappProvider String? // BAILEYS | META_CLOUD | null

  // Meta Cloud API credentials (encrypted with TOKEN_ENCRYPTION_KEY)
  metaPhoneNumberId String?
  metaAccessToken   String? // 🔒 AES-256-GCM ciphertext
  metaBusinessId    String?
  metaTemplateName  String?

  // Baileys (whatsapp-web.js) connection status
  baileysConnected    Boolean   @default(false)
  baileysPhoneNumber  String?
  baileysLastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// Audit row for each bulk demand-slip generation run.
// One row per (school, billingMonth, billingYear, trigger) — gives the
// admin "what happened on May 1st" visibility plus retry/error logs.
model FeeDemandRun {
  id            String  @id @default(cuid())
  schoolId      String
  billingMonth  Int // 1-12
  billingYear   Int
  triggerType   String  @default("MANUAL") // MANUAL | CRON
  triggeredBy   String? // userId
  status        String  @default("running") // running | completed | failed | partial
  totalStudents Int     @default(0)
  successCount  Int     @default(0)
  skippedCount  Int     @default(0)
  failedCount   Int     @default(0)
  totalAmount   Float   @default(0)
  filters       String? // JSON: { classId, sectionId, studentIds[] }
  errorLog      String? // JSON array of {studentId, error}

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  school   School              @relation(fields: [schoolId], references: [id])
  invoices StudentFeeInvoice[]

  @@index([schoolId])
  @@index([schoolId, billingYear, billingMonth])
  @@index([status])
}

// Tracks WhatsApp / SMS / email delivery attempts for a fee invoice.
// Phase 5 will populate this; Phase 1 just creates the table.
model FeeNotification {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  invoiceId     String
  channel       String // WHATSAPP | SMS | EMAIL
  provider      String? // BAILEYS | META_CLOUD | ...
  recipient     String // phone number or email
  status        String    @default("pending") // pending | sent | delivered | read | failed
  providerMsgId String?
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school  School            @relation(fields: [schoolId], references: [id])
  invoice StudentFeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([schoolId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@index([providerMsgId])
}

// ============================================
// ATTENDANCE
// ============================================

model Attendance {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  academicYear String    @default("2025-2026")
  date         DateTime
  status       String // present, absent, leave, late, half_day
  remarks      String?
  markedBy     String?
  finalized    Boolean   @default(false)
  finalizedAt  DateTime?
  finalizedBy  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school       School  @relation(fields: [schoolId], references: [id])
  student      Student @relation(fields: [studentId], references: [id])
  markedByUser User?   @relation("markedByUser", fields: [markedBy], references: [id])

  @@unique([schoolId, studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([date])
  @@index([schoolId, date])
}

model AttendanceAuditLog {
  id           String   @id @default(cuid())
  schoolId     String
  academicYear String
  date         DateTime
  classId      String
  sectionId    String?
  action       String // finalize, reopen
  reason       String?
  performedBy  String
  createdAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  actor  User   @relation("attendanceAuditActor", fields: [performedBy], references: [id])

  @@index([schoolId])
  @@index([academicYear])
  @@index([schoolId, date, classId, sectionId])
  @@index([performedBy])
}

// Per-student attendance change log. Only mutations are recorded (when an
// existing Attendance row's status or remarks change). First-time marks are
// covered by Attendance.createdAt + markedBy, so they are intentionally NOT
// logged here. Use this for accountability when someone reopens a finalized
// attendance and edits a student's status.
model AttendanceChangeLog {
  id           String   @id @default(cuid())
  schoolId     String
  academicYear String
  studentId    String
  date         DateTime
  oldStatus    String
  newStatus    String
  oldRemarks   String?
  newRemarks   String?
  changedBy    String
  changedAt    DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  changer User    @relation("attendanceChanger", fields: [changedBy], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@index([schoolId, date])
  @@index([schoolId, studentId, date])
  @@index([changedBy])
  @@index([changedAt])
}

// ============================================
// TIMETABLE
