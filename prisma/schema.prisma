// Multi-tenant SaaS School Management ERP System
// All tables include tenant_id (school_id) for data isolation
// Soft delete supported via deleted_at

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USER MANAGEMENT
// ============================================

model User {
  id                    String    @id @default(cuid())
  employeeId            String?
  email                 String    @unique
  password              String
  name                  String
  phone                 String?
  avatar                String?
  dob                   DateTime?
  drivingLicenseNumber  String?
  mustChangePassword    Boolean   @default(false)
  role                  String // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT
  schoolId              String?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  impersonatingSchoolId String? // SUPER_ADMIN only — active impersonation target
  // Bumped on password change to invalidate every outstanding session. JWTs
  // carry `tv` in their payload; refresh re-reads this and rejects mismatches.
  tokenVersion          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  school              School?               @relation(fields: [schoolId], references: [id])
  userRoles           UserRole[]
  userPermissions     UserPermission[]
  markedAttendance    Attendance[]          @relation("markedByUser")
  finalizedAttendance Attendance[]          @relation("finalizedByUser")
  attendanceAuditLogs AttendanceAuditLog[]  @relation("attendanceAuditActor")
  attendanceChanges   AttendanceChangeLog[] @relation("attendanceChanger")
  loginEvents         LoginEvent[]
  accountLockout      AccountLockout?
  passwordResetTokens PasswordResetToken[]
  feeAuditLogs        FeeAuditLog[]
  feeConfigAuditLogs  FeeConfigAuditLog[]
  rfidCardsAssigned   StudentCard[]         @relation("rfidCardsAssigned")
  rfidCardsRevoked    StudentCard[]         @relation("rfidCardsRevoked")

  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([role])
}

// ============================================
// SCHOOL / TENANT MANAGEMENT
// ============================================

model School {
  id             String    @id @default(cuid())
  name           String
  logo           String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  country        String    @default("India")
  contactPhone   String?
  contactEmail   String?
  website        String?
  academicYear   String    @default("2025-2026")
  board          String    @default("CBSE") // CBSE, ICSE, State
  timezone       String    @default("Asia/Kolkata")
  currency       String    @default("INR")
  subdomain      String    @unique
  status         String    @default("pending") // pending, active, suspended, trial
  trialEndsAt    DateTime?
  onboardingDate DateTime?
  favicon        String?
  printHeader    String? // Base64 banner image used as header on all printables (admission form, fee receipt, etc.)
  registrationNumber String?
  udiseNumber     String?
  affiliationNumber String?
  establishedYear String?
  principalSignature String?
  primaryColor   String?
  dashboardFont  String?   @default("system")
  features       String? // JSON string of enabled features
  workingDays    String    @default("[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"]") // JSON array of weekday names this school operates on
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  users                       User[]
  classes                     Class[]
  sections                    Section[]
  subjects                    Subject[]
  students                    Student[]
  teachers                    Teacher[]
  drivers                     Driver[]
  staff                       Staff[]
  parents                     Parent[]
  feesHeads                   FeesHead[]
  feesGroups                  FeesGroup[]
  feesStructures              FeesStructure[]
  feeCollections              FeeCollection[]
  studentFeeAssignments       StudentFeeAssignment[]
  studentFeeInvoices          StudentFeeInvoice[]
  studentFeePayments          StudentFeePayment[]
  studentFeeLedgerEntries     StudentFeeLedgerEntry[]
  studentFeeLedgerAllocations StudentFeeLedgerAllocation[]
  feeAuditLogs                FeeAuditLog[]
  feeConfigAuditLogs          FeeConfigAuditLog[]
  studentWithdrawals          StudentWithdrawal[]
  studentFeeRefunds           StudentFeeRefund[]
  transportEvents             TransportEvent[]
  attendance                  Attendance[]
  attendanceAuditLogs         AttendanceAuditLog[]
  attendanceChanges           AttendanceChangeLog[]
  studentCards                StudentCard[]
  rfidDevices                 RfidDevice[]
  rfidTapLogs                 RfidTapLog[]
  timetables                  Timetable[]
  periodConfigs               PeriodConfig[]
  exams                       Exam[]
  examResults                 ExamResult[]
  examParadigms               ExamParadigm[]
  gradeScales                 GradeScale[]
  reportCardTemplates         ReportCardTemplate[]
  examAuditLogs               ExamAuditLog[]
  transportRoutes             TransportRoute[]
  hostels                     Hostel[]
  hostelEvents                HostelEvent[]
  libraryBooks                LibraryBook[]
  bookIssues                  BookIssue[]
  inventoryItems              InventoryItem[]
  inventoryCategories         InventoryCategory[]
  inventoryItemVariants       InventoryItemVariant[]
  inventoryStockMovements     InventoryStockMovement[]
  inventorySales              InventorySale[]
  inventorySaleReturns        InventorySaleReturn[]
  pettyCash                   PettyCashEntry[]
  notifications               Notification[]
  salaryStructures            SalaryStructure[]
  salaryPayments              SalaryPayment[]
  advanceRequests             AdvanceRequest[]
  announcements               Announcement[]
  supportTickets              SupportTicket[]
  admissions                  Admission[]
  admissionSetting            AdmissionSetting?
  studentAcademicEnrollments  StudentAcademicEnrollment[]
  academicYears               AcademicYear[]
  classTeacherAssignments     ClassTeacherAssignment[]
  schoolPermissions           SchoolPermission[]
  roles                       Role[]
  holidays                    Holiday[]
  feeDemandConfig             FeeDemandConfig?
  feeDemandRuns               FeeDemandRun[]
  feeNotifications            FeeNotification[]
  idCardTemplates             IdCardTemplate[]
  idCardGenerationLogs        IdCardGenerationLog[]

  @@index([subdomain])
  @@index([status])
}

// ============================================
// ACADEMIC STRUCTURE
// ============================================

model AcademicYear {
  id        String    @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isCurrent])
  @@index([isActive])
}

model Holiday {
  id           String    @id @default(cuid())
  schoolId     String
  academicYear String
  date         DateTime // start date (inclusive)
  endDate      DateTime? // end date (inclusive); null = single-day holiday
  name         String
  type         String    @default("school") // public | school | vacation
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, academicYear])
  @@index([date])
}

model Class {
  id        String    @id @default(cuid())
  schoolId  String
  name      String // Class 1, Class 2, ... Class 12, Nursery, LKG, UKG (required)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school                     School                      @relation(fields: [schoolId], references: [id])
  sections                   Section[]
  students                   Student[]
  studentAcademicEnrollments StudentAcademicEnrollment[]
  feesStructures             FeesStructure[]
  feeAssignments             StudentFeeAssignment[]
  classSubjects              ClassSubject[]
  classTeacherAssignments    ClassTeacherAssignment[]

  @@index([schoolId])
}

model Section {
  id        String    @id @default(cuid())
  schoolId  String
  classId   String
  name      String // A, B, C, D
  teacherId String? // Class teacher
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school                     School                      @relation(fields: [schoolId], references: [id])
  class                      Class                       @relation(fields: [classId], references: [id])
  students                   Student[]
  studentAcademicEnrollments StudentAcademicEnrollment[]
  timetables                 Timetable[]
  feesStructures             FeesStructure[]
  feeAssignments             StudentFeeAssignment[]
  classTeacherAssignments    ClassTeacherAssignment[]

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([classId])
}

model ClassTeacherAssignment {
  id           String    @id @default(cuid())
  schoolId     String
  academicYear String
  classId      String
  sectionId    String?
  teacherId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school  School   @relation(fields: [schoolId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
  teacher Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([schoolId, academicYear, sectionId])
  @@index([schoolId, academicYear])
  @@index([classId])
  @@index([teacherId])
}

model Subject {
  id         String    @id @default(cuid())
  schoolId   String
  name       String
  code       String?
  sequenceNo Int?
  type       String    @default("primary") // primary, optional, extra, special
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  school        School         @relation(fields: [schoolId], references: [id])
  timetables    Timetable[]
  classSubjects ClassSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

// ============================================
// PEOPLE MANAGEMENT
// ============================================

model Student {
  id                String    @id @default(cuid())
  schoolId          String
  classId           String?
  sectionId         String?
  admissionNumber   String?   @unique
  rollNumber        String?
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            String? // Male, Female, Other
  nationality       String?   @default("Indian")
  religion          String?
  category          String? // General, OBC, SC, ST, EWS
  motherTongue      String?
  aadhaarNumber     String?
  bloodGroup        String?
  medicalConditions String? // JSON: allergies, conditions, medications
  address           String?
  city              String?
  state             String?
  pincode           String?
  country           String?   @default("India")
  profileImage      String?
  admissionDate     DateTime?
  previousSchool    String?
  previousSchoolTC  String? // TC number
  previousClass     String? // Last attended class
  previousResult    String? // Pass/Fail/Percentage
  transferCertNo    String? // TC issued by this school
  siblingId         String? // Link to sibling student (historical breadcrumb; family group lives in familyId)
  familyId          String? // Shared id across all members of one family
  admissionStatus   String    @default("admitted") // admitted, promoted, detained, transferred, alumni, withdrawn
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  school               School                       @relation(fields: [schoolId], references: [id])
  class                Class?                       @relation(fields: [classId], references: [id])
  section              Section?                     @relation(fields: [sectionId], references: [id])
  parentLinks          StudentParent[]
  attendance           Attendance[]
  attendanceChanges    AttendanceChangeLog[]
  rfidCards            StudentCard[]
  rfidTapLogs          RfidTapLog[]                 @relation("rfidTapLogs")
  feeCollections       FeeCollection[]
  feeAssignments       StudentFeeAssignment[]
  academicEnrollments  StudentAcademicEnrollment[]
  feeInvoices          StudentFeeInvoice[]
  feePayments          StudentFeePayment[]
  feeLedgerEntries     StudentFeeLedgerEntry[]
  feeLedgerAllocations StudentFeeLedgerAllocation[]
  examResults          ExamResult[]
  marksEntries         MarksEntry[]
  admission            Admission?
  withdrawals          StudentWithdrawal[]
  feeRefunds           StudentFeeRefund[]
  feeAuditLogs         FeeAuditLog[]
  inventorySales       InventorySale[]

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([admissionNumber])
  @@index([admissionStatus])
  @@index([familyId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, admissionStatus])
}

model StudentAcademicEnrollment {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  academicYear   String
  classId        String
  sectionId      String?
  rollNumber     String?
  status         String    @default("active") // active, promoted, detained, transferred, withdrawn
  source         String    @default("admission") // admission, promotion, manual
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  promotedFromId String?
  remarks        String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school  School   @relation(fields: [schoolId], references: [id])
  student Student  @relation(fields: [studentId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@unique([studentId, academicYear])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYear])
  @@index([classId])
  @@index([sectionId])
  @@index([status])
}

// ============================================
// ADMISSION MODULE
// ============================================

model Admission {
  id              String  @id @default(cuid())
  schoolId        String
  studentId       String? @unique // Linked after student creation
  admissionNumber String? // Auto-generated: STD-2025-001
  academicYear    String  @default("2025-2026")
  admissionType   String  @default("new") // new, transfer, re-admission
  status          String  @default("applied") // applied, documents_verified, fee_pending, admitted, rejected, withdrawn, waitlisted

  // Personal Info (Tab 1)
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  dateOfAdmission    DateTime? // Date of admission
  gender             String? // Boy, Girl, Other
  nationality        String?   @default("Indian")
  religion           String?
  category           String? // General, OBC, SC, ST, EWS
  caste              String? // Sub-caste
  motherTongue       String?
  aadhaarNumber      String?
  bloodGroup         String?
  medicalConditions  String? // JSON
  profileImage       String?
  registrationNumber String? // Registration No / Admission No (manual)
  penNumber          String? // PEN / Government ID
  samagraId          String?
  apaarId            String?
  udiseId            String?
  heightCm           Float? // Height in CMs
  weightKg           Float? // Weight in KGs

  // Contact / Address (Tab 2)
  address            String? // Permanent / Official Address (Street, Landmark, Area)
  city               String?
  state              String?
  pincode            String?
  country            String? @default("India")
  village            String? // Village / Post
  postOffice         String?
  policeStation      String?
  wardNo             String?
  localAddress       String? // Local / Residential Address
  localVillage       String?
  localPostOffice    String?
  localPoliceStation String?
  localWardNo        String?
  localCity          String?
  localState         String?
  localPincode       String?
  localCountry       String?
  sameAsPermanent    Boolean @default(true) // Local same as permanent

  // Mother's Info (Tab 2)
  motherName       String?
  motherPhone      String?
  motherEmail      String?
  motherOccupation String?
  motherAadhaar    String?
  motherEducation  String? // Educational Qualification
  motherIncome     Float? // Yearly Income

  // Father's Info (Tab 2)
  fatherName       String?
  fatherPhone      String?
  fatherEmail      String?
  fatherOccupation String?
  fatherAadhaar    String?
  fatherEducation  String? // Educational Qualification
  fatherIncome     Float? // Yearly Income

  // Other Details (Tab 2)
  belongsToEws      Boolean @default(false) // Belongs to EWS
  isSingleGirlChild Boolean @default(false)
  isDivyangian      Boolean @default(false) // Divyangian (differently abled)

  // General Details (Tab 3)
  classId             String? // Class Admitted
  sectionId           String?
  admissionSession    String? // Admission Session
  mediumOfInstruction String? // Language medium
  area                String? // Rural, Urban, Semi-Urban

  // Last Institution Details (Tab 3)
  previousSchool        String? // Institution Name
  previousSchoolAddress String? // Institution Address
  previousClass         String? // Class Last Attended
  previousResult        String? // Result of Last Class
  affiliatedTo          String? // Affiliated To
  previousSchoolTC      String? // TC Number
  tcDate                DateTime? // TC Date

  // Transport Details (Tab 3)
  transportRouteId String?
  transportStop    String?

  // Hostel Details (Tab 3)
  hostelName   String?
  hostelRoomNo String?
  hostelBedNo  String?
  // Structured hostel snapshot (current allocation; mirrors transportRouteId/transportStop).
  hostelId     String?
  hostelRoomId String?
  hostelBedId  String?

  // Accounts Info (Tab 4)
  bankAccountNumber  String?
  ifscCode           String?
  monthlyFeeDiscount Float?  @default(0) // Monthly Fee Discount Amount
  feeId              String? // Fee ID
  concessionNo       String? // Concession No.
  transportDiscount  Float?  @default(0) // Transport Discount Amount
  feesGroupId        String? // Fee Group

  // Family
  annualIncome Float?
  siblingId    String? // Sibling already in school (historical breadcrumb; family group lives in familyId)
  familyId     String? // Shared id across all members of one family

  // Parent address
  sameAddressAsStudent Boolean @default(true)
  fatherAddress        String?
  motherAddress        String?

  // Concession & Source
  concessionType   String? // sibling, staff, scholarship, other
  concessionReason String?
  sourceOfInfo     String? // newspaper, website, referral, walk_in, other
  formNumber       String? // Physical form number

  // Admission workflow
  appliedDate      DateTime  @default(now())
  verifiedBy       String?
  verifiedAt       DateTime?
  admittedBy       String?
  admittedAt       DateTime?
  rejectedReason   String?
  waitlistPosition Int?

  // Additional
  remarks   String?
  createdBy String? // User who created the application
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school     School              @relation(fields: [schoolId], references: [id])
  student    Student?            @relation(fields: [studentId], references: [id])
  documents  AdmissionDocument[]
  notes      AdmissionNote[]
  activities AdmissionActivity[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, registrationNumber])
  @@index([schoolId])
  @@index([status])
  @@index([classId])
  @@index([familyId])
}

// Per-school, per-kind, per-year counter for admission/registration/employee numbers.
// Row-level lock on UPDATE ... increment serializes allocation so two
// simultaneous records can never receive the same sequence number, and the
// increment rolls back with the surrounding transaction (no gaps from
// abandoned transactions).
model NumberCounter {
  schoolId  String
  kind      String // 'admission' | 'registration' | 'employee'
  year      Int // calendar year of dateOfAdmission; or 0 when resetYearly is false
  lastValue Int // last sequence number allocated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([schoolId, kind, year])
}

model AdmissionDocument {
  id                 String    @id @default(cuid())
  admissionId        String
  documentType       String // birth_certificate, aadhaar, transfer_cert, marksheet, passport_photo, caste_cert, income_cert, migration_cert, character_cert, other
  documentName       String
  fileUrl            String? // File path/URL
  fileSize           Int? // In KB
  fileType           String? // image/jpeg, application/pdf, etc.
  uploadedAt         DateTime?
  verificationStatus String    @default("pending") // pending, verified, rejected
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  isRequired         Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
  @@index([documentType])
  @@index([verificationStatus])
}

model AdmissionNote {
  id          String   @id @default(cuid())
  admissionId String
  note        String
  noteType    String   @default("general") // general, phone_call, email, visit, follow_up
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
}

model AdmissionActivity {
  id          String   @id @default(cuid())
  admissionId String
  action      String // created, status_changed, document_uploaded, document_verified, document_rejected, note_added, field_updated, admitted, rejected
  fromValue   String? // Previous value (for status changes)
  toValue     String? // New value
  performedBy String
  description String?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
  @@index([action])
  @@index([createdAt])
}

model AdmissionSetting {
  id                         String    @id @default(cuid())
  schoolId                   String    @unique
  admissionNumberPrefix      String    @default("STD")
  admissionNumberFormat      String    @default("{PREFIX}-{YEAR}-{SEQ}") // {PREFIX}, {YEAR}, {SEQ}, {CLASS}
  registrationNumberPrefix   String    @default("REG")
  registrationNumberFormat   String    @default("{PREFIX}-{YEAR}-{SEQ}") // {PREFIX}, {YEAR}, {YY}, {SEQ}, {CLASS}
  registrationSequenceStart  Int       @default(1)
  registrationSequenceDigits Int       @default(3)
  registrationResetYearly    Boolean   @default(true)
  employeeNumberPrefix       String    @default("EMP")
  employeeNumberFormat       String    @default("{PREFIX}-{SEQ}") // {PREFIX}, {YEAR}, {YY}, {SEQ}
  employeeSequenceStart      Int       @default(1)
  employeeSequenceDigits     Int       @default(4)
  employeeResetYearly        Boolean   @default(false)
  sequenceStart              Int       @default(1)
  sequenceDigits             Int       @default(3) // 001, 0001, etc.
  resetSequenceYearly        Boolean   @default(true)
  academicYear               String    @default("2025-2026")
  admissionOpenDate          DateTime?
  admissionCloseDate         DateTime?
  minAge                     Int       @default(3)
  maxAge                     Int       @default(18)
  ageCalculationDate         String    @default("april_1") // april_1, july_1, admission_date
  requiredDocuments          String? // JSON array of required document types
  customFields               String? // JSON array of custom field definitions
  allowOnlineSubmission      Boolean   @default(false)
  requirePhoto               Boolean   @default(true)
  requireAadhaar             Boolean   @default(false)
  maxApplicationsPerClass    Int?
  enableWaitlist             Boolean   @default(true)
  autoVerifyDocuments        Boolean   @default(false)
  admissionFeeRequired       Boolean   @default(true)
  formFeeAmount              Float     @default(0)
  notificationEmails         String? // JSON array of email templates config
  printTemplate              String? // JSON for print layout
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Teacher {
  id             String    @id @default(cuid())
  schoolId       String
  userId         String?
  employeeId     String?
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  aadhaarNumber  String?
  qualification  String?
  specialization String?
  experience     Int       @default(0)
  joinDate       DateTime?
  profileImage   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school                  School                   @relation(fields: [schoolId], references: [id])
  timetables              Timetable[]
  classTeacherAssignments ClassTeacherAssignment[]
  salaryStructure         SalaryStructure?
  salaryPayments          SalaryPayment[]
  advanceRequests         AdvanceRequest[]

  @@index([schoolId])
  @@index([schoolId, employeeId])
}

model Driver {
  id                   String    @id @default(cuid())
  schoolId             String
  userId               String?
  employeeId           String?
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  gender               String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  drivingLicenseNumber String?
  joinDate             DateTime?
  profileImage         String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([userId])
}

model Staff {
  id            String    @id @default(cuid())
  schoolId      String
  userId        String?
  employeeId    String?
  firstName     String
  lastName      String
  gender        String?
  dateOfBirth   DateTime?
  joinDate      DateTime?
  designation   String?
  department    String?
  qualification String?
  experience    Int       @default(0)
  address       String?
