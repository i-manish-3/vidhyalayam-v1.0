# Database — PostgreSQL (for production/Vercel deployment)
# Local: postgresql://z:postgres@127.0.0.1:5432/vidhyalayam
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Neon: postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/[DB]?sslmode=require
DATABASE_URL=postgresql://z:postgres@127.0.0.1:5432/vidhyalayam

# JWT Secret — Change this in production!
# If not set, a default secret is used (NOT secure for production)
JWT_SECRET=school-erp-super-secret-key-2025

# ============================================
# FILE STORAGE — Cloudflare R2 (S3-compatible)
# ============================================
# In production, all uploaded files (school logos, student/teacher photos,
# admission documents, etc.) are stored in R2 — not in the database.
#
# Setup:
#   1. Sign up at https://dash.cloudflare.com/sign-up
#   2. Enable R2 (free tier: 10 GB storage, unlimited downloads)
#   3. Create a bucket (e.g. "erp-files")
#   4. Generate API token: R2 → "Manage R2 API Tokens" → Create with Read+Write
#   5. Optional: bind a custom domain like https://files.yourerp.com to the bucket
#      (otherwise use the *.r2.dev development URL)
#   6. Fill the 5 vars below
#
# Leave STORAGE_DRIVER=local for dev — files will be written to public/uploads/
# instead of being uploaded to R2. Switch to STORAGE_DRIVER=r2 when ready.
STORAGE_DRIVER=local

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=erp-files
# Public base URL for serving files. With custom domain: https://files.yourerp.com
# Without custom domain (use R2 dev URL): https://pub-<hash>.r2.dev
R2_PUBLIC_URL=
