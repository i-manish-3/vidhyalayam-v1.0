# Database — PostgreSQL (for production/Vercel deployment)
# Local: postgresql://z:postgres@127.0.0.1:5432/vidhyalayam
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Neon: postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/[DB]?sslmode=require
#
# Multi-tenant note: when many schools generate/send demand slips at once,
# Prisma's default connection pool (~num_cpus * 2 + 1) becomes the bottleneck.
# Bump it via the `connection_limit` query param. Recommended for 50-200
# tenants on a single Node instance:
#   ?connection_limit=50&pool_timeout=20
DATABASE_URL=postgresql://z:postgres@127.0.0.1:5432/vidhyalayam

# JWT Secret — Change this in production!
# If not set, a default secret is used (NOT secure for production)
JWT_SECRET=school-erp-super-secret-key-2025

# ============================================
# TOKEN ENCRYPTION KEY — required for fee demand WhatsApp config
# ============================================
# 32-byte (64 hex chars) key used to AES-256-GCM encrypt sensitive tokens
# stored in the database — currently the Meta WhatsApp Cloud access token
# and Baileys session blobs in FeeDemandConfig.
#
# Generate one with: openssl rand -hex 32
#
# DO NOT change this in production once schools have saved tokens — rotating
# the key without re-encrypting existing values will make those tokens
# unreadable. If you must rotate, decrypt-then-re-encrypt all values first.
TOKEN_ENCRYPTION_KEY=

# ============================================
# PUBLIC APP URL — used in WhatsApp messages
# ============================================
# Base URL parents see in their WhatsApp message link to view a demand slip.
# Must be reachable from the internet (parent's phone). For local dev a tunnel
# like ngrok is needed if you want real WhatsApp clicks to work.
#
# No trailing slash. Example: https://erp.dpsdelhi.com
PUBLIC_APP_URL=http://localhost:3000

# ============================================
# FILE STORAGE — Cloudflare R2 (S3-compatible)
# ============================================
# In production, all uploaded files (school logos, student/teacher photos,
# admission documents, etc.) are stored in R2 — not in the database.
#
# Setup:
#   1. Sign up at https://dash.cloudflare.com/sign-up
#   2. Enable R2 (free tier: 10 GB storage, unlimited downloads)
#   3. Create a bucket (e.g. "erp-files")
#   4. Generate API token: R2 → "Manage R2 API Tokens" → Create with Read+Write
#   5. Optional: bind a custom domain like https://files.yourerp.com to the bucket
#      (otherwise use the *.r2.dev development URL)
#   6. Fill the 5 vars below
#
# Leave STORAGE_DRIVER=local for dev — files will be written to public/uploads/
# instead of being uploaded to R2. Switch to STORAGE_DRIVER=r2 when ready.
STORAGE_DRIVER=local

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=erp-files
# Public base URL for serving files. With custom domain: https://files.yourerp.com
# Without custom domain (use R2 dev URL): https://pub-<hash>.r2.dev
R2_PUBLIC_URL=

# ============================================
# META WEBHOOK SECRETS — for delivery / read receipts
# ============================================
# Configure both in Meta Developer App → WhatsApp → Configuration → Webhooks.
# Verify token: any string you choose; paste the same value in the Meta UI.
# App secret: from your Meta App's Settings → Basic → App Secret (used to
# verify the x-hub-signature-256 on incoming webhook POSTs).
#
# Without these set, the webhook returns 503 (verify) / skips processing
# (POST) without crashing. Configure once when you wire up the Meta app.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# ============================================
# FEE DEMAND — concurrency knobs
# ============================================
# Bulk slip generation: how many students per school are processed in parallel
# inside one bulk request. Higher = faster generation, but each one opens a DB
# transaction so values >10 risk exhausting the Prisma pool.
# Default: 5
FEE_DEMAND_GENERATE_CONCURRENCY=5

# WhatsApp send worker: max number of distinct schools whose pending rows are
# drained in a single tick. Each tick is POLL_MS apart and sends one message
# per school in parallel. So total throughput ≈ MAX_SCHOOLS messages / POLL_MS.
# E.g. 20 schools * (1000ms/1500ms) ≈ 13 msg/s globally, with fair sharing.
# Default: 20 schools, 1500ms tick.
WHATSAPP_WORKER_MAX_SCHOOLS=20
WHATSAPP_WORKER_POLL_MS=1500
